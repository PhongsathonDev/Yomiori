{
  "id": "ch-18",
  "novelId": "boyish-friend",
  "chapterNumber": 18,
  "title": "Ch.18 — บทงานวัฒนธรรม - ลบความกลัวของเพื่อนสมัยเด็กทิ้งไป (วันที่ 12 อังคาร เย็น)",
  "novelTitle": "[18+] เรื่องราวของการพรากเพื่อนสนิทสาวที่น่ารักอันดับสองในห้อง มาเป็นของตัวเองด้วยทริปทัศนศึกษาสองคืนสามวัน",
  "blocks": [
    {
      "id": "b1",
      "type": "narration",
      "text": "ฉันกับอายะกลั้นหายใจและฟังสิ่งที่เกิดขึ้นนอกประตู"
    },
    {
      "id": "b2",
      "type": "narration",
      "text": "เสียงฝีเท้าของเพื่อนผู้หญิงของอายะดังไปทั่วห้องศิลปะ"
    },
    {
      "id": "b3",
      "type": "narration",
      "text": "'โอ๊ะ! สีระบายภาพนี่ใช่ไหม?'"
    },
    {
      "id": "b4",
      "type": "narration",
      "text": "'จะยกไปไหม?'"
    },
    {
      "id": "b5",
      "type": "narration",
      "text": "'อายะอยู่ไหนเนี่ย'"
    },
    {
      "id": "b6",
      "type": "narration",
      "text": "'ไปห้องน้ำหรือเปล่า?'"
    },
    {
      "id": "b7",
      "type": "narration",
      "text": "'รอไหม?'"
    },
    {
      "id": "b8",
      "type": "narration",
      "text": "เสียงเก้าอี้ในห้องศิลปะถูกลากไปบนพื้น"
    },
    {
      "id": "b9",
      "type": "narration",
      "text": "ดูเหมือนว่าพวกเธอจะตัดสินใจนั่งรอบโต๊ะ"
    },
    {
      "id": "b10",
      "type": "narration",
      "text": "'ได้ยินมาว่าไปออกเดตคู่ที่สวนสนุกมา'"
    },
    {
      "id": "b11",
      "type": "narration",
      "text": "'หืม? ใคร?'"
    },
    {
      "id": "b12",
      "type": "narration",
      "text": "'อายะกับพวกนั้นไง'"
    },
    {
      "id": "b13",
      "type": "narration",
      "text": "'อ๋อเหรอ'"
    },
    {
      "id": "b14",
      "type": "narration",
      "text": "การไปสวนสนุกในวันอาทิตย์กลายเป็นเรื่องของ 'เดตคู่'"
    },
    {
      "id": "b15",
      "type": "narration",
      "text": "โทกิตะเป็นคนกระจายข่าวหรือเปล่านะ"
    },
    {
      "id": "b16",
      "type": "narration",
      "text": "'อยากให้รักกันไปนานๆ'"
    },
    {
      "id": "b17",
      "type": "narration",
      "text": "'เป็นคู่รักนกแมนดารินเลยนะ~'"
    },
    {
      "id": "b18",
      "type": "narration",
      "text": "'โทกิตะเป็นคนดีนะ'"
    },
    {
      "id": "b19",
      "type": "narration",
      "text": "ดูเหมือนว่าในหมู่ผู้หญิงโทกิตะจะค่อนข้างป๊อปปูลาร์"
    },
    {
      "id": "b20",
      "type": "narration",
      "text": "ก็เข้าใจได้"
    },
    {
      "id": "b21",
      "type": "narration",
      "text": "ก่อนจะคบกับอายะ"
    },
    {
      "id": "b22",
      "type": "narration",
      "text": "เขาเคยโดนสารภาพรักจากผู้หญิงหลายคน"
    },
    {
      "id": "b23",
      "type": "narration",
      "text": "ทันใดนั้นกล่องสีระบายภาพที่อายะถืออยู่ก็เอียง"
    },
    {
      "id": "b24",
      "type": "narration",
      "text": "แล้วกล่องหนึ่งก็เกือบจะหล่น"
    },
    {
      "id": "b25",
      "type": "narration",
      "text": "ฉันรีบจับกล่องนั้นไว้แล้วซ้อนกลับไป"
    },
    {
      "id": "b26",
      "type": "narration",
      "text": "อายะแข็งทื่อจนไม่รู้ตัว"
    },
    {
      "id": "b27",
      "type": "narration",
      "text": "'โทกิตะเพิ่งถูกสารภาพรักจากเด็กปีหนึ่งนะ'"
    },
    {
      "id": "b28",
      "type": "narration",
      "text": "'เอ๊ะ! เมื่อไหร่?'"
    },
    {
      "id": "b29",
      "type": "narration",
      "text": "'แต่เขาก็ปฏิเสธไปอย่างง่ายดาย'"
    },
    {
      "id": "b30",
      "type": "narration",
      "text": "'ก็แน่ล่ะนะ~'"
    },
    {
      "id": "b31",
      "type": "narration",
      "text": "'อายะถูกรักมากเลยนะเนี่ย'"
    },
    {
      "id": "b32",
      "type": "narration",
      "text": "'บอกตรงๆ ว่าอิจฉามาก'"
    },
    {
      "id": "b33",
      "type": "narration",
      "text": "'มีแฟนที่ซื่อสัตย์แบบนั้นดีนะ~'"
    },
    {
      "id": "b34",
      "type": "narration",
      "text": "'นั่นก็เพราะคู่ของเขาคืออายะ'"
    },
    {
      "id": "b35",
      "type": "narration",
      "text": "'เอ๊ะ! เป็นอย่างนั้นเหรอ?'"
    },
    {
      "id": "b36",
      "type": "narration",
      "text": "'ก็น่าจะเป็นอย่างนั้นนะ?'"
    },
    {
      "id": "b37",
      "type": "narration",
      "text": "'ก็เป็นอายะนี่นา'"
    },
    {
      "id": "b38",
      "type": "narration",
      "text": "'เลยอยากจะเชียร์ไง'"
    },
    {
      "id": "b39",
      "type": "narration",
      "text": "ทันใดนั้นบทสนทนาก็หยุดลง"
    },
    {
      "id": "b40",
      "type": "narration",
      "text": "'เอาจริงๆ ถ้าไม่ได้คบกับโทกิตะนะ~'"
    },
    {
      "id": "b41",
      "type": "narration",
      "text": "'อื้ม'"
    },
    {
      "id": "b42",
      "type": "narration",
      "text": "'พวกเราจะชนะไหม?'"
    },
    {
      "id": "b43",
      "type": "narration",
      "text": "'ห๊ะ! อะไรของเธอเนี่ย'"
    },
    {
      "id": "b44",
      "type": "narration",
      "text": "'ก็เคยได้ยินว่ารุ่นพี่ฮายาชิที่อยู่ชมรมบาสเก็ตบอลก็ชอบอายะเหมือนกันไม่ใช่เหรอ'"
    },
    {
      "id": "b45",
      "type": "narration",
      "text": "'อ๋อ! เรื่องนั้นน่ะเหรอ'"
    },
    {
      "id": "b46",
      "type": "narration",
      "text": "'ถ้าไม่ได้คบกับโทกิตะ"
    },
    {
      "id": "b47",
      "type": "narration",
      "text": "พวกเราจะเป็นเพื่อนกับอายะอย่างที่ทำอยู่ตอนนี้ได้ไหมนะ?'"
    },
    {
      "id": "b48",
      "type": "narration",
      "text": "ไหล่ของอายะกระตุก"
    },
    {
      "id": "b49",
      "type": "narration",
      "text": "ฉันใช้ร่างกายของฉันดันกล่องสีไว้เพื่อไม่ให้มันหล่นลงมา"
    },
    {
      "id": "b50",
      "type": "narration",
      "text": "'....ก็ต้องเป็นได้สิ"
    },
    {
      "id": "b51",
      "type": "narration",
      "text": "อายะเป็นเด็กดีนะ'"
    },
    {
      "id": "b52",
      "type": "narration",
      "text": "'ก็คงงั้นแหละ'"
    },
    {
      "id": "b53",
      "type": "narration",
      "text": "'ใช่ๆ'"
    },
    {
      "id": "b54",
      "type": "narration",
      "text": "เพื่อนผู้หญิงของเธอเปลี่ยนน้ำเสียงให้สดใสขึ้น"
    },
    {
      "id": "b55",
      "type": "narration",
      "text": "เพียงชั่วครู่"
    },
    {
      "id": "b56",
      "type": "narration",
      "text": "ก็มีความรู้สึกไม่ดีเกิดขึ้น"
    },
    {
      "id": "b57",
      "type": "narration",
      "text": "นี่คือบรรยากาศที่อายะกลัวหรือเปล่านะ"
    },
    {
      "id": "b58",
      "type": "narration",
      "text": "อายะเป็นคนที่อ่อนไหวมาก"
    },
    {
      "id": "b59",
      "type": "narration",
      "text": "เธอกลัวสิ่งนี้มาตลอด"
    },
    {
      "id": "b60",
      "type": "narration",
      "text": "ทันใดนั้น"
    },
    {
      "id": "b61",
      "type": "narration",
      "text": "เสียงฝีเท้าหนักๆ ก็เข้ามาใกล้จากทางเดิน"
    },
    {
      "id": "b62",
      "type": "narration",
      "text": "'นี่... อู้เหรอไง'"
    },
    {
      "id": "b63",
      "type": "narration",
      "text": "เสียงของโทกิตะ"
    },
    {
      "id": "b64",
      "type": "narration",
      "text": "'โอ๊ะ... พูดถึงก็มาพอดีเลยโทกิตะ'"
    },
    {
      "id": "b65",
      "type": "narration",
      "text": "'เลียนแบบเอโตะไม่เหมือนเลย!'"
    },
    {
      "id": "b66",
      "type": "narration",
      "text": "น้ำเสียงของเพื่อนผู้หญิงเปลี่ยนไปอีกระดับ"
    },
    {
      "id": "b67",
      "type": "narration",
      "text": "'แล้วอายะล่ะ?'"
    },
    {
      "id": "b68",
      "type": "narration",
      "text": "เสียงฝีเท้าของโทกิตะเดินวนไปมาในห้องศิลปะ"
    },
    {
      "id": "b69",
      "type": "narration",
      "text": "'อืม... เข้าห้อง... ห้องน้ำหรือเปล่า?'"
    },
    {
      "id": "b70",
      "type": "narration",
      "text": "'เข้าห้องๆ อะไรของเธอน่ะ'"
    },
    {
      "id": "b71",
      "type": "narration",
      "text": "พวกเธอหัวเราะกันอย่างสนุกสนาน"
    },
    {
      "id": "b72",
      "type": "narration",
      "text": "'อ๊ะ... โทกิตะ... นี่ๆ'"
    },
    {
      "id": "b73",
      "type": "narration",
      "text": "'หืม?'"
    },
    {
      "id": "b74",
      "type": "narration",
      "text": "'นี่ของฝากจากอายะ'"
    },
    {
      "id": "b75",
      "type": "narration",
      "text": "ดูเหมือนว่าพวกเธอจะเอาลังสีที่อายะวางไว้บนโต๊ะให้โทกิตะดู"
    },
    {
      "id": "b76",
      "type": "narration",
      "text": "เหมือนจะบอกให้เขาช่วยแบกไปด้วย"
    },
    {
      "id": "b77",
      "type": "narration",
      "text": "'พวกเธอนี่นะ~'"
    },
    {
      "id": "b78",
      "type": "narration",
      "text": "โทกิตะหัวเราะด้วยน้ำเสียงที่ประหลาดใจ"
    },
    {
      "id": "b79",
      "type": "narration",
      "text": "นี่ก็เป็นตัวตนที่แท้จริงของโทกิตะเหมือนกันนะ"
    },
    {
      "id": "b80",
      "type": "narration",
      "text": "'ล้อเล่นน่ะ... มาช่วยกันยกสิหัวหน้า'"
    },
    {
      "id": "b81",
      "type": "narration",
      "text": "'งั้น... ช่วยคนละกล่องก็ได้..."
    },
    {
      "id": "b82",
      "type": "narration",
      "text": "ที่เหลือฉันจะยกไปเอง'"
    },
    {
      "id": "b83",
      "type": "narration",
      "text": "'โอ้... สมกับเป็นผู้ชาย'"
    },
    {
      "id": "b84",
      "type": "narration",
      "text": "'เปล่าหรอก... ใครๆ ก็ยกได้น่า...'"
    },
    {
      "id": "b85",
      "type": "narration",
      "text": "ขณะที่พวกเขากำลังคุยกัน"
    },
    {
      "id": "b86",
      "type": "narration",
      "text": "เสียงฝีเท้าก็ค่อยๆ หายไปจากทางเดิน"
    },
    {
      "id": "b87",
      "type": "narration",
      "text": "ความเงียบกลับคืนมา"
    },
    {
      "id": "b88",
      "type": "narration",
      "text": "ฉันได้ยินเสียงหายใจที่ไม่สม่ำเสมอของอายะ"
    },
    {
      "id": "b89",
      "type": "narration",
      "text": "เธอกำกล่องสีไว้แน่น"
    },
    {
      "id": "b90",
      "type": "narration",
      "text": "และสั่นเล็กน้อย"
    },
    {
      "id": "b91",
      "type": "narration",
      "text": "น้ำตาที่หางตาของเธอเกือบจะไหลออกมา"
    },
    {
      "id": "b92",
      "type": "narration",
      "text": "อายะก็ยังคงเป็นเด็กขี้แยเหมือนเดิม"
    },
    {
      "id": "b93",
      "type": "narration",
      "text": "ตอนประถมห้า"
    },
    {
      "id": "b94",
      "type": "narration",
      "text": "เมื่อฉันได้อยู่ห้องเดียวกับอายะ"
    },
    {
      "id": "b95",
      "type": "narration",
      "text": "ความประทับใจแรกของฉันคือ 'เด็กที่ไม่ค่อยมีความมั่นใจ'"
    },
    {
      "id": "b96",
      "type": "narration",
      "text": "ฉันไม่รู้ว่าเกิดอะไรขึ้นกับเธอในห้องก่อนหน้านี้"
    },
    {
      "id": "b97",
      "type": "narration",
      "text": "เพราะอายะไม่เคยเล่าให้ฟัง"
    },
    {
      "id": "b98",
      "type": "narration",
      "text": "แต่ฉันคิดว่าเธอคงถูกกลั่นแกล้งในห้องเรียน"
    },
    {
      "id": "b99",
      "type": "narration",
      "text": "ซึ่งอาจจะเป็นสาเหตุของความหวาดกลัวของเธอ"
    },
    {
      "id": "b100",
      "type": "narration",
      "text": "อายะที่อยู่ตรงหน้าฉันตอนนี้"
    },
    {
      "id": "b101",
      "type": "narration",
      "text": "คืออายะในตอนนั้นเลย"
    },
    {
      "id": "b102",
      "type": "narration",
      "text": "เธอเขินอายและประหม่าเวลาพูดคุยกับคนอื่น"
    },
    {
      "id": "b103",
      "type": "narration",
      "text": "ความรู้สึกในใจของอายะไหลเข้ามา"
    },
    {
      "id": "b104",
      "type": "narration",
      "text": "จากร่างกายที่สัมผัสกันเบาๆ"
    },
    {
      "id": "b105",
      "type": "narration",
      "text": "---ฉัน..."
    },
    {
      "id": "b106",
      "type": "narration",
      "text": "ไม่สามารถเปลี่ยนแปลงได้"
    },
    {
      "id": "b107",
      "type": "narration",
      "text": "ถ้าฉันเปลี่ยนไป"
    },
    {
      "id": "b108",
      "type": "narration",
      "text": "มันจะพัง"
    },
    {
      "id": "b109",
      "type": "narration",
      "text": "ทุกอย่างจะพัง"
    },
    {
      "id": "b110",
      "type": "narration",
      "text": "ทุกคนต้องเกลียดฉันแน่ๆ"
    },
    {
      "id": "b111",
      "type": "narration",
      "text": "ทุกอย่างจะพังแน่นอน"
    },
    {
      "id": "b112",
      "type": "narration",
      "text": "มันเจ็บปวด"
    },
    {
      "id": "b113",
      "type": "narration",
      "text": "ฉันอยู่กับโบยัน"
    },
    {
      "id": "b114",
      "type": "narration",
      "text": "ถ้าอยู่กับโบยัน"
    },
    {
      "id": "b115",
      "type": "narration",
      "text": "แต่ว่า..."
    },
    {
      "id": "b116",
      "type": "narration",
      "text": "มันจะพัง"
    },
    {
      "id": "b117",
      "type": "narration",
      "text": "ไม่..."
    },
    {
      "id": "b118",
      "type": "narration",
      "text": "ฉันไม่ต้องการ"
    },
    {
      "id": "b119",
      "type": "narration",
      "text": "แต่ว่า..."
    },
    {
      "id": "b120",
      "type": "narration",
      "text": "หัวใจของอายะเต็มไปด้วยความหวาดกลัวและความสับสน"
    },
    {
      "id": "b121",
      "type": "narration",
      "text": "เธอคงควบคุมอารมณ์ไม่ได้"
    },
    {
      "id": "b122",
      "type": "narration",
      "text": "เธอหายใจติดขัด 'ฮึบ... ฮึบ...'"
    },
    {
      "id": "b123",
      "type": "narration",
      "text": "เหมือนกำลังจะหายใจไม่ออกและล้มลงไป"
    },
    {
      "id": "b124",
      "type": "narration",

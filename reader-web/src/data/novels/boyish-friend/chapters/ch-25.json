{
  "id": "ch-25",
  "novelId": "boyish-friend",
  "chapterNumber": 25,
  "title": "Ch.25 — บทงานวัฒนธรรม - ไปโรงเรียนพร้อมเพื่อนสมัยเด็ก (วันที่ 15 ศุกร์ เช้า)",
  "novelTitle": "[18+] เรื่องราวของการพรากเพื่อนสนิทสาวที่น่ารักอันดับสองในห้อง มาเป็นของตัวเองด้วยทริปทัศนศึกษาสองคืนสามวัน",
  "blocks": [
    {
      "id": "b1",
      "type": "narration",
      "text": "---ตื่นได้แล้ว"
    },
    {
      "id": "b2",
      "type": "narration",
      "text": "สัญชาตญาณเตือนในหัว"
    },
    {
      "id": "b3",
      "type": "narration",
      "text": "ฉันลืมตาขึ้นทันที"
    },
    {
      "id": "b4",
      "type": "narration",
      "text": "เมื่อมองดูนาฬิกา"
    },
    {
      "id": "b5",
      "type": "narration",
      "text": "ก็พบว่ายังไม่ถึงหกโมงเช้าเลย"
    },
    {
      "id": "b6",
      "type": "narration",
      "text": "ฉันเกาหัว"
    },
    {
      "id": "b7",
      "type": "narration",
      "text": "แล้วคิดในหัวที่ยังง่วงอยู่"
    },
    {
      "id": "b8",
      "type": "narration",
      "text": "เมื่อคืนฉันกอดอายะจนดึกดื่นในสวนสาธารณะ"
    },
    {
      "id": "b9",
      "type": "narration",
      "text": "แล้วก็ไปส่งอายะที่บ้าน"
    },
    {
      "id": "b10",
      "type": "narration",
      "text": "จากนั้นฉันก็กลับมา"
    },
    {
      "id": "b11",
      "type": "narration",
      "text": "ทิ้งตัวลงบนเตียง"
    },
    {
      "id": "b12",
      "type": "narration",
      "text": "แล้วก็หมดสติไปเลย"
    },
    {
      "id": "b13",
      "type": "narration",
      "text": "วันนี้... ใช่แล้ว วันแรกของงานโรงเรียน"
    },
    {
      "id": "b14",
      "type": "narration",
      "text": "โรงเรียนอยู่ห่างออกไปประมาณสี่สิบนาที"
    },
    {
      "id": "b15",
      "type": "narration",
      "text": "ถ้าฉันนอนต่ออีกหน่อยก็ยังไปทันอยู่ดี"
    },
    {
      "id": "b16",
      "type": "narration",
      "text": "---ไปรับสิ"
    },
    {
      "id": "b17",
      "type": "narration",
      "text": "ใช่แล้ว"
    },
    {
      "id": "b18",
      "type": "narration",
      "text": "อายะพักผ่อนไม่เพียงพอเมื่อเร็วๆ นี้"
    },
    {
      "id": "b19",
      "type": "narration",
      "text": "เมื่อวานเธอทำงานพิเศษ"
    },
    {
      "id": "b20",
      "type": "narration",
      "text": "แล้วก็เดินกลับบ้านกับฉันเป็นเวลาหนึ่งชั่วโมงครึ่ง"
    },
    {
      "id": "b21",
      "type": "narration",
      "text": "แล้วก็ถูกฉันเขย่าเสียยับเยิน..."
    },
    {
      "id": "b22",
      "type": "narration",
      "text": "อายะที่รักการนอนมากกว่าใครๆ"
    },
    {
      "id": "b23",
      "type": "narration",
      "text": "จะต้องตื่นสายแน่ๆ"
    },
    {
      "id": "b24",
      "type": "narration",
      "text": "วันนี้อายะต้องไปทำหน้าที่"
    },
    {
      "id": "b25",
      "type": "narration",
      "text": "เป็นคนจับข้อเท้าในบ้านผีสิง"
    },
    {
      "id": "b26",
      "type": "narration",
      "text": "ดังนั้นเธอต้องไปโรงเรียนเร็ว"
    },
    {
      "id": "b27",
      "type": "narration",
      "text": "เพื่อเตรียมความพร้อม"
    },
    {
      "id": "b28",
      "type": "narration",
      "text": "ฉันรีบเตรียมตัวไปโรงเรียน"
    },
    {
      "id": "b29",
      "type": "narration",
      "text": "แล้วก็ออกจากบ้าน"
    },
    {
      "id": "b30",
      "type": "narration",
      "text": "ติ๊งต่อง---"
    },
    {
      "id": "b31",
      "type": "narration",
      "text": "ฉันกดออดบ้านของอายะ"
    },
    {
      "id": "b32",
      "type": "narration",
      "text": "เสียง "
    },
    {
      "id": "b33",
      "type": "narration",
      "text": "\"กริ๊ก\""
    },
    {
      "id": "b34",
      "type": "narration",
      "text": " ดังขึ้น"
    },
    {
      "id": "b35",
      "type": "narration",
      "text": "แล้วประตูก็เปิดออก"
    },
    {
      "id": "b36",
      "type": "narration",
      "text": "แม่ของอายะโผล่หน้าออกมา"
    },
    {
      "id": "b37",
      "type": "dialogue",
      "text": "\"อ้าว... โบยัน...",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b38",
      "type": "dialogue",
      "text": "อรุณสวัสดิ์...",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b39",
      "type": "dialogue",
      "text": "มาหาอายะเหรอ?\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b40",
      "type": "dialogue",
      "text": "\"อรุณสวัสดิ์ครับ",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b41",
      "type": "dialogue",
      "text": "วันนี้อายะต้องไปโรงเรียนเร็วครับ\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b42",
      "type": "dialogue",
      "text": "\"เอ๊ะ... จริงเหรอ!",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b43",
      "type": "dialogue",
      "text": "ลูกสาวฉันต้องยังหลับอยู่แน่ๆ!",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b44",
      "type": "dialogue",
      "text": "รอเดี๋ยวนะ!\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b45",
      "type": "narration",
      "text": "ประตูถูกปิดลง"
    },
    {
      "id": "b46",
      "type": "narration",
      "text": "ฉันได้ยินเสียง "
    },
    {
      "id": "b47",
      "type": "narration",
      "text": "\"ตับ ตับ ตับ ตับ\""
    },
    {
      "id": "b48",
      "type": "narration",
      "text": "ที่ดังมาจากบันไดในบ้าน"
    },
    {
      "id": "b49",
      "type": "narration",
      "text": "ฉันถอยออกจากประตู"
    },
    {
      "id": "b50",
      "type": "narration",
      "text": "แล้วมองขึ้นไปที่ห้องของอายะ"
    },
    {
      "id": "b51",
      "type": "narration",
      "text": "บนชั้นสอง"
    },
    {
      "id": "b52",
      "type": "narration",
      "text": "ฉันได้ยินเสียงของแม่ของอายะดังออกมาจากหน้าต่างห้องนั้น"
    },
    {
      "id": "b53",
      "type": "narration",
      "text": "...ไม่สิ"
    },
    {
      "id": "b54",
      "type": "narration",
      "text": "เสียงดังมากทีเดียว"
    },
    {
      "id": "b55",
      "type": "narration",
      "text": "'อายะ ตื่นได้แล้ว!"
    },
    {
      "id": "b56",
      "type": "narration",
      "text": "โบยันมารอแล้ว!"
    },
    {
      "id": "b57",
      "type": "narration",
      "text": "อายะ!"
    },
    {
      "id": "b58",
      "type": "narration",
      "text": "...ใช่แล้ว โบยัน!"
    },
    {
      "id": "b59",
      "type": "narration",
      "text": "วันนี้ลูกต้องไปโรงเรียนเร็วไม่ใช่เหรอ?"
    },
    {
      "id": "b60",
      "type": "narration",
      "text": "...ใช่แล้ว"
    },
    {
      "id": "b61",
      "type": "narration",
      "text": "โบยันมารับลูกแล้ว!'"
    },
    {
      "id": "b62",
      "type": "narration",
      "text": "ฉันหยิบสมาร์ทโฟนออกมา"
    },
    {
      "id": "b63",
      "type": "narration",
      "text": "แล้วโทรหาอายะ"
    },
    {
      "id": "b64",
      "type": "narration",
      "text": "แค่เสียงเรียกเข้าครั้งแรก"
    },
    {
      "id": "b65",
      "type": "narration",
      "text": "อายะก็รับสาย"
    },
    {
      "id": "b66",
      "type": "dialogue",
      "text": "\"อายะ อรุณสวัสดิ์...",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b67",
      "type": "dialogue",
      "text": "ตื่นไหวไหม?\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b68",
      "type": "narration",
      "text": "'อู้วว...'"
    },
    {
      "id": "b69",
      "type": "dialogue",
      "text": "\"ฉันจำได้ว่าเธอเคยบอกว่า",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b70",
      "type": "dialogue",
      "text": "วันนี้ต้องไปเตรียมงานโรงเรียนนะ\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b71",
      "type": "narration",
      "text": "'อู้วววว..."
    },
    {
      "id": "b72",
      "type": "narration",
      "text": "โบยัน..."
    },
    {
      "id": "b73",
      "type": "narration",
      "text": "อรุณสวัสดิ์..."
    },
    {
      "id": "b74",
      "type": "narration",
      "text": "อู้วว...'"
    },
    {
      "id": "b75",
      "type": "narration",
      "text": "อายะครางออกมาด้วยเสียงที่แหบแห้ง"
    },
    {
      "id": "b76",
      "type": "narration",
      "text": "นี่คือ..."
    },
    {
      "id": "b77",
      "type": "narration",
      "text": "เสียงของอายะตอนที่ง่วงที่สุด"
    },
    {
      "id": "b78",
      "type": "narration",
      "text": "ฉันคิดว่าเธอจะหลับภายในสามวินาที"
    },
    {
      "id": "b79",
      "type": "narration",
      "text": "เมื่อฉันเห็นอนาคตที่แน่นอนนั้น"
    },
    {
      "id": "b80",
      "type": "narration",
      "text": "ฉันก็หัวเราะออกมาเบาๆ"
    },
    {
      "id": "b81",
      "type": "dialogue",
      "text": "\"อายะ...",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b82",
      "type": "dialogue",
      "text": "ฉันรักเธอนะ",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b83",
      "type": "dialogue",
      "text": "ไปโรงเรียนด้วยกันเถอะ\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b84",
      "type": "narration",
      "text": "'........อื้ม'"
    },
    {
      "id": "b85",
      "type": "narration",
      "text": "หลังจากนั้น"
    },
    {
      "id": "b86",
      "type": "narration",
      "text": "ฉันก็ได้ยินเสียง "
    },
    {
      "id": "b87",
      "type": "narration",
      "text": "\"ครืด ครืด\""
    },
    {
      "id": "b88",
      "type": "narration",
      "text": "ดังออกมาจากโทรศัพท์"
    },
    {
      "id": "b89",
      "type": "narration",
      "text": "อายะคงจะลุกขึ้นอย่างช้าๆ"
    },
    {
      "id": "b90",
      "type": "narration",
      "text": "แล้วก็เริ่มเตรียมตัว"
    },
    {
      "id": "b91",
      "type": "narration",
      "text": "'โบยัน..."
    },
    {
      "id": "b92",
      "type": "narration",
      "text": "อยู่ข้างล่างเหรอ?'"
    },
    {
      "id": "b93",
      "type": "narration",
      "text": "อายะถาม"
    },
    {
      "id": "b94",
      "type": "narration",
      "text": "ในขณะที่เสียงของเธอกลับมาเป็นปกติ"
    },
    {
      "id": "b95",
      "type": "dialogue",
      "text": "\"อื้ม...",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b96",
      "type": "dialogue",
      "text": "อยู่บนถนน\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b97",
      "type": "narration",
      "text": "ผ้าม่านในห้องของอายะเปิดออกเล็กน้อย"
    },
    {
      "id": "b98",
      "type": "narration",
      "text": "'ขอโทษนะ"
    },
    {
      "id": "b99",
      "type": "narration",
      "text": "รอหน่อยนะ'"
    },
    {
      "id": "b100",
      "type": "dialogue",
      "text": "\"อื้ม...",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b101",
      "type": "dialogue",
      "text": "ฉันจะรอ\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b102",
      "type": "narration",
      "text": "ตุ๊กตาลิงปรากฏขึ้นจากช่องว่างของผ้าม่าน"
    },
    {
      "id": "b103",
      "type": "narration",
      "text": "แล้วก็ถูกวางไว้ที่ขอบหน้าต่าง"
    },
    {
      "id": "b104",
      "type": "narration",
      "text": "นี่คงเป็นสัญญาณให้ฉันรอดูตุ๊กตาลิง"
    },
    {
      "id": "b105",
      "type": "narration",
      "text": "ฉันรออายะออกมา"
    },
    {
      "id": "b106",
      "type": "narration",
      "text": "ขณะที่มองดูตุ๊กตาลิงอย่างเหม่อลอย"
    },
    {
      "id": "b107",
      "type": "dialogue",
      "text": "\"กริ๊ก\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b108",
      "type": "narration",
      "text": "ประตูเปิดออก"
    },
    {
      "id": "b109",
      "type": "narration",
      "text": "อายะก็ออกมา"
    },
    {
      "id": "b110",
      "type": "dialogue",
      "text": "\"ขอโทษนะ...",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b111",
      "type": "dialogue",
      "text": "ที่ให้รอนาน\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b112",
      "type": "narration",
      "text": "อายะใส่เสื้อยืดสีดำ"
    },
    {
      "id": "b113",
      "type": "narration",
      "text": "มีตัวอักษรสีชมพูที่ดูน่ากลัว"
    },
    {
      "id": "b114",
      "type": "narration",
      "text": "เขียนว่า "
    },
    {
      "id": "b115",
      "type": "narration",
      "text": "\"Haunted house\""
    },
    {
      "id": "b116",
      "type": "narration",
      "text": "ซึ่งเป็นเสื้อยืดที่โทกิตะ"
    },
    {
      "id": "b117",
      "type": "narration",
      "text": "เป็นคนเสนอให้ทำ"
    },
    {
      "id": "b118",
      "type": "narration",
      "text": "เขาเคยรวบรวมเงินจากทุกคนที่สนใจ"
    },
    {
      "id": "b119",
      "type": "narration",
      "text": "ฉันไม่ได้ซื้อ"
    },
    {
      "id": "b120",
      "type": "narration",
      "text": "ก็แล้วไป"
    },
    {
      "id": "b121",
      "type": "narration",
      "text": "แต่..."
    },
    {
      "id": "b122",
      "type": "dialogue",
      "text": "\"อายะ...",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b123",
      "type": "dialogue",
      "text": "เธอจะใส่ชุดแบบนี้ไปข้างนอกเหรอ?\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b124",
      "type": "dialogue",
      "text": "\"หือ?",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b125",
      "type": "dialogue",
      "text": "อ๊ะ...\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b126",
      "type": "narration",
      "text": "อายะใส่กางเกงขาสั้นสีดำ"
    },
    {
      "id": "b127",
      "type": "narration",
      "text": "และสวมหมวกแก๊ปสีน้ำเงิน"
    },
    {
      "id": "b128",
      "type": "narration",
      "text": "ชุดของเธอดูน่ารัก..."
    },
    {
      "id": "b129",
      "type": "narration",
      "text": "แต่ก็ดูพังก์ไปหน่อย"
    },
    {
      "id": "b130",
      "type": "narration",
      "text": "หลังจากใส่เสื้อยืดแล้ว"
    },
    {
      "id": "b131",
      "type": "narration",
      "text": "เธอก็คงจะเปลี่ยนเป็นชุดปกติด้วยความง่วง"
    },
    {
      "id": "b132",
      "type": "narration",
      "text": "เธอยังคงง่วงอยู่"
    },
    {
      "id": "b133",
      "type": "narration",
      "text": "อายะพูดว่า "
    },
    {
      "id": "b134",
      "type": "dialogue",
      "text": "\"ขอโทษนะ",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b135",
      "type": "dialogue",
      "text": "รอแป๊บนึง!\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b136",
      "type": "narration",
      "text": "แล้วก็วิ่งกลับเข้าไปในบ้าน"
    },
    {
      "id": "b137",
      "type": "narration",
      "text": "ฉันกับอายะเดินไปตามเส้นทางไปโรงเรียน"
    },
    {
      "id": "b138",
      "type": "narration",
      "text": "ในตอนเช้า"
    },
    {
      "id": "b139",
      "type": "narration",
      "text": "อายะใส่เสื้อยืดสีดำ"
    },
    {
      "id": "b140",
      "type": "narration",
      "text": "กับกระโปรงสีกรมท่า"
    },
    {
      "id": "b141",
      "type": "narration",
      "text": "ซึ่งเป็นชุดนักเรียน"
    },
    {
      "id": "b142",
      "type": "narration",
      "text": "แน่นอนว่าเธอไม่ได้ใส่หมวกแก๊ป"
    },
    {
      "id": "b143",
      "type": "narration",
      "text": "ผมสั้นสีน้ำตาลของเธอดูง่วงๆ"
    },
    {
      "id": "b144",
      "type": "narration",
      "text": "ฉันพยายามพูดคุยกับอายะ"
    },
    {
      "id": "b145",
      "type": "narration",
      "text": "เพื่อไม่ให้เธอหลับ"
    },
    {
      "id": "b146",
      "type": "dialogue",
      "text": "\"เมื่อคืน",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b147",
      "type": "dialogue",
      "text": "นอนหลับทันทีเลยไหม?\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b148",
      "type": "dialogue",
      "text": "\"อ๊ะ...",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b149",
      "type": "dialogue",
      "text": "อื้ม...",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b150",
      "type": "dialogue",
      "text": "อาบน้ำแล้วก็นอนเลย\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b151",
      "type": "narration",
      "text": "ใบหน้าของเธอแดงเล็กน้อย"
    },
    {
      "id": "b152",
      "type": "narration",
      "text": "และเธอก็ก้มหน้าลงอย่างขวยเขิน"
    },
    {
      "id": "b153",
      "type": "dialogue",
      "text": "\"งั้นก็...",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b154",
      "type": "dialogue",
      "text": "นอนไปแค่สี่ชั่วโมงกว่าเองสินะ",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b155",
      "type": "dialogue",
      "text": "คงจะลำบากสำหรับอายะนะ\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b156",
      "type": "dialogue",
      "text": "\"ไม่ ไม่",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b157",
      "type": "dialogue",
      "text": "ฉันตื่นเต็มที่แล้ว!\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b158",
      "type": "dialogue",
      "text": "\"แน่ใจเหรอ?",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b159",
      "type": "dialogue",
      "text": "เมื่อกี้เสียงของอายะ",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b160",
      "type": "dialogue",
      "text": "เหมือนซอมบี้เลยนะ\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b161",
      "type": "dialogue",
      "text": "\"ซอม...บี้...?",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b162",
      "type": "dialogue",
      "text": "อย่าดูถูกซอมบี้นะ!\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b163",
      "type": "narration",
      "text": "อายะคงจะอาย"
    },
    {
      "id": "b164",
      "type": "narration",
      "text": "เธอเลยตะโกนเรื่องไร้สาระออกมา"
    },
    {
      "id": "b165",
      "type": "narration",
      "text": "ฉันหัวเราะไปกับท่าทางที่เป็นปกติของอายะ"
    },
    {
      "id": "b166",
      "type": "narration",
      "text": "ไม่รู้ว่านานแค่ไหนแล้ว"
    },
    {
      "id": "b167",
      "type": "narration",
      "text": "ที่ฉันกับอายะได้มาเดินไปโรงเรียนด้วยกันแบบนี้"
    },
    {
      "id": "b168",
      "type": "narration",
      "text": "ฉันจำได้ว่า"
    },
    {
      "id": "b169",
      "type": "narration",
      "text": "หลังจากอายะเริ่มคบกับโทกิตะ"
    },
    {
      "id": "b170",
      "type": "narration",
      "text": "เราก็ไม่ค่อยได้ไปโรงเรียนด้วยกันแล้ว"
    },
    {
      "id": "b171",
      "type": "narration",
      "text": "แม้ว่าอายะจะยุ่งอยู่กับชมรมตอนเช้าก็ตาม"
    },
    {
      "id": "b172",
      "type": "narration",
      "text": "แต่ฉันก็รู้สึกว่าควรจะเว้นระยะห่าง"
    },
    {
      "id": "b173",
      "type": "narration",
      "text": "แต่ในบางครั้ง"
    },
    {
      "id": "b174",
      "type": "narration",
      "text": "เมื่อฉันบังเอิญเจออายะที่สถานีรถไฟ"
    },
    {
      "id": "b175",
      "type": "narration",
      "text": "ฉันก็จะรู้สึกเหมือนจะมีเรื่องดีๆ เกิดขึ้นในวันนั้น"
    },
    {
      "id": "b176",
      "type": "dialogue",
      "text": "\"โบยัน ขอโทษนะ",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b177",
      "type": "dialogue",
      "text": "ขอแวะร้านสะดวกซื้อหน่อย!\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b178",
      "type": "narration",
      "text": "อายะคงไม่ได้กินอาหารเช้ามา"
    },
    {
      "id": "b179",
      "type": "narration",
      "text": "เธอหรี่ตาด้วยความง่วง"
    },
    {
      "id": "b180",
      "type": "narration",
      "text": "แล้วก็หยิบขนมปังกับน้ำผลไม้มา"
    },
    {
      "id": "b181",
      "type": "dialogue",
      "text": "\"จะไปกินที่ลานหน้าสถานีรถไฟไหม?\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b182",
      "type": "dialogue",
      "text": "\"ไม่เอา",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b183",
      "type": "dialogue",
      "text": "จะกินตรงนี้แหละ",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b184",
      "type": "dialogue",
      "text": "รอหน่อยนะ\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b185",
      "type": "narration",
      "text": "อายะพูด"
    },
    {
      "id": "b186",
      "type": "narration",
      "text": "แล้วก็แกะถุงขนมปังหน้ามินิมาร์ท"
    },
    {
      "id": "b187",
      "type": "dialogue",
      "text": "\"ถ้าเป็นที่ลาน",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b188",
      "type": "dialogue",
      "text": "เธอก็จะนั่งได้นะ\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b189",
      "type": "dialogue",
      "text": "\"เพราะหน้าสถานีรถไฟ",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b190",
      "type": "dialogue",
      "text": "อาจจะมีคนรู้จัก\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b191",
      "type": "dialogue",
      "text": "\"ทุกคนก็รู้ว่าอายะเป็นคนตะกละ\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b192",
      "type": "dialogue",
      "text": "\"ไม่ใช่อย่างนั้นนะ...",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b193",
      "type": "dialogue",
      "text": "อ้ำ\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b194",
      "type": "narration",
      "text": "ฉันรอ"
    },
    {
      "id": "b195",
      "type": "narration",
      "text": "อายะที่กำลังกินขนมปังอย่างเอร็ดอร่อย"
    },
    {
      "id": "b196",
      "type": "narration",
      "text": "แล้วเธอก็ซดน้ำผลไม้จนหมด"
    },
    {
      "id": "b197",
      "type": "narration",
      "text": "ทิ้งถังขยะ"
    },
    {
      "id": "b198",
      "type": "narration",
      "text": "แล้วก็เดินไปกับฉันอีกครั้ง"
    },
    {
      "id": "b199",
      "type": "narration",
      "text": "ขณะที่เราเดินเคียงข้างกัน"
    },
    {
      "id": "b200",
      "type": "narration",
      "text": "มือของอายะก็สัมผัสกับมือของฉัน"
    },
    {
      "id": "b201",
      "type": "narration",
      "text": "เธอคงบังเอิญแตะโดน"
    },
    {
      "id": "b202",
      "type": "narration",
      "text": "ในตอนนั้น"
    },
    {
      "id": "b203",
      "type": "narration",
      "text": "ความรู้สึกของอายะก็ถูกส่งมาถึงฉัน"
    },
    {
      "id": "b204",
      "type": "narration",
      "text": "(มือของโบยัน"
    },
    {
      "id": "b205",
      "type": "narration",
      "text": "โดนแล้ว"
    },
    {
      "id": "b206",
      "type": "narration",
      "text": "อื้ม..."
    },
    {
      "id": "b207",
      "type": "narration",
      "text": "ใจเต้นแรง"
    },
    {
      "id": "b208",
      "type": "narration",
      "text": "มือนี้...)"
    },
    {
      "id": "b209",
      "type": "narration",
      "text": "แล้วมือของอายะก็ผละออกไปทันที"
    },
    {
      "id": "b210",
      "type": "narration",
      "text": "มือนี้..."
    },
    {
      "id": "b211",
      "type": "narration",
      "text": "ทำไมถึงเป็นแบบนี้"
    },
    {
      "id": "b212",
      "type": "narration",
      "text": "ทั้งที่ฉันแตะตัวอายะมาหลายครั้งแล้ว"
    },
    {
      "id": "b213",
      "type": "narration",
      "text": "ทุกซอกทุกมุม"
    },
    {
      "id": "b214",
      "type": "narration",
      "text": "แต่..."
    },
    {
      "id": "b215",
      "type": "narration",
      "text": "ฉันก็รู้สึกอาย"
    },
    {
      "id": "b216",
      "type": "narration",
      "text": "แล้วก็ใจเต้นแรงเหมือนกัน"
    },
    {
      "id": "b217",
      "type": "narration",
      "text": "อาจเป็นเพราะนี่คือ"
    },
    {
      "id": "b218",
      "type": "narration",
      "text": "เส้นทางไปโรงเรียนในชีวิตประจำวัน"
    },
    {
      "id": "b219",
      "type": "narration",
      "text": "จะมีวันที่ฉันกับอายะ"
    },
    {
      "id": "b220",
      "type": "narration",
      "text": "ไปโรงเรียนด้วยกัน"
    },
    {
      "id": "b221",
      "type": "narration",
      "text": "โดยจับมือกันแบบนี้ไหมนะ"
    },
    {
      "id": "b222",
      "type": "narration",
      "text": "---มีสิ"
    },
    {
      "id": "b223",
      "type": "narration",
      "text": "สัญชาตญาณบอกแบบนั้น"
    },
    {
      "id": "b224",
      "type": "narration",
      "text": "ใช่แล้ว"
    },
    {
      "id": "b225",
      "type": "narration",
      "text": "อีกไม่นานวันนั้นก็จะมาถึง"
    },
    {
      "id": "b226",
      "type": "narration",
      "text": "ดังนั้น"
    },
    {
      "id": "b227",
      "type": "narration",
      "text": "ตอนนี้ต้องอดทนไว้"
    },
    {
      "id": "b228",
      "type": "narration",
      "text": "ถ้ามีคนเห็น"
    },
    {
      "id": "b229",
      "type": "narration",
      "text": "อายะคงจะรู้สึกไม่สบายใจ"
    },
    {
      "id": "b230",
      "type": "dialogue",
      "text": "\"นี่โบยัน\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b231",
      "type": "dialogue",
      "text": "\"หือ?\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b232",
      "type": "dialogue",
      "text": "\"ฉันไม่ได้ตะกละนะ\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b233",
      "type": "narration",
      "text": "เธอดูบึ้งตึงเล็กน้อย"
    },
    {
      "id": "b234",
      "type": "narration",
      "text": "ขณะที่มองตรงไปข้างหน้า"
    },
    {
      "id": "b235",
      "type": "narration",
      "text": "ท่าทางของเธอน่ารัก"
    },
    {
      "id": "b236",
      "type": "narration",
      "text": "จนฉันอยากจะกอดเธอ"
    },
    {
      "id": "b237",
      "type": "narration",
      "text": "ถ้าเราเป็นแฟนกัน"
    },
    {
      "id": "b238",
      "type": "narration",
      "text": "ฉันคงจะกอดอายะไปโรงเรียนแน่ๆ"
    },
    {
      "id": "b239",
      "type": "narration",
      "text": "ไม่ดีแล้ว"
    },
    {
      "id": "b240",
      "type": "narration",
      "text": "ฉันเองก็อดนอนเหมือนกัน"
    },
    {
      "id": "b241",
      "type": "narration",
      "text": "ความคิดของฉันเลยล่องลอยไป"
    },
    {
      "id": "b242",
      "type": "narration",
      "text": "เอาเป็นว่า"
    },
    {
      "id": "b243",
      "type": "narration",
      "text": "ฉันควรจะปลอบเพื่อนสมัยเด็กที่กำลังงอนอยู่"
    },
    {
      "id": "b244",
      "type": "dialogue",
      "text": "\"ฉันรู้แล้ว\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b245",
      "type": "narration",
      "text": "เมื่อเร็วๆ นี้"
    },
    {
      "id": "b246",
      "type": "narration",
      "text": "อายะหยุดกินเค้กและขนม"
    },
    {
      "id": "b247",
      "type": "narration",
      "text": "ทันที"
    },
    {
      "id": "b248",
      "type": "narration",
      "text": "ฉันจำได้ว่า"
    },
    {
      "id": "b249",
      "type": "narration",
      "text": "เธอเคยโดนโทกิตะว่า "
    },
    {
      "id": "b250",
      "type": "narration",
      "text": "\"ดูอวบไปหน่อย\""
    },
    {
      "id": "b251",
      "type": "narration",
      "text": "แม้ว่าจะพูดแบบนั้น"
    },
    {
      "id": "b252",
      "type": "narration",
      "text": "แต่เมื่อกี้เธอก็กินขนมปังไส้ถั่วแดงอย่างเอร็ดอร่อย"
    },
    {
      "id": "b253",
      "type": "narration",
      "text": "ฉันเกือบจะพูดหยอกล้อเธอไปแล้ว"
    },
    {
      "id": "b254",
      "type": "narration",
      "text": "---หยุดเถอะ"
    },
    {
      "id": "b255",
      "type": "narration",
      "text": "สัญชาตญาณของพระเจ้าเตือนฉัน"
    },
    {
      "id": "b256",
      "type": "narration",
      "text": "อายะคงจะเจ็บปวดเล็กน้อย"
    },
    {
      "id": "b257",
      "type": "narration",
      "text": "ถ้าอย่างนั้น"
    },
    {
      "id": "b258",
      "type": "narration",
      "text": "ฉันจะพูดแทน..."
    },
    {
      "id": "b259",
      "type": "dialogue",
      "text": "\"...ฉันแค่คิดว่า",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b260",
      "type": "dialogue",
      "text": "อายะกินอะไรก็ดูน่าอร่อยไปหมดเลย\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b261",
      "type": "narration",
      "text": "ฉันชอบดูอายะกิน"
    },
    {
      "id": "b262",
      "type": "narration",
      "text": "ฉันจึงบอกความรู้สึกนั้นกับเธอ"
    },
    {
      "id": "b263",
      "type": "dialogue",
      "text": "\"ขอบ... คุณ...",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b264",
      "type": "dialogue",
      "text": "อ้าว...",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b265",
      "type": "dialogue",
      "text": "นี่ก็หมายความว่าฉันตะกละอยู่ดีนี่!\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b266",
      "type": "narration",
      "text": "เมื่อเราพูดคุยเรื่องไร้สาระกัน"
    },
    {
      "id": "b267",
      "type": "narration",
      "text": "เราก็มาถึงสถานีรถไฟอย่างรวดเร็ว"
    },
    {
      "id": "b268",
      "type": "narration",
      "text": "จากตรงนี้"
    },
    {
      "id": "b269",
      "type": "narration",
      "text": "เราจะขึ้นรถไฟไปหนึ่งสถานี"
    },
    {
      "id": "b270",
      "type": "narration",
      "text": "แล้วเดินต่ออีกเล็กน้อยก็จะถึงโรงเรียน"
    },
    {
      "id": "b271",
      "type": "narration",
      "text": "ฉันเริ่มเห็นนักเรียนในชุดยูนิฟอร์มเดียวกัน"
    },
    {
      "id": "b272",
      "type": "narration",
      "text": "พูดคุยกันมากขึ้น"
    },
    {
      "id": "b273",
      "type": "narration",
      "text": "อายะพูดน้อยลง"
    },
    {
      "id": "b274",
      "type": "narration",
      "text": "และฉันก็รู้สึกได้ถึงความตึงเครียดของเธอ"
    },
    {
      "id": "b275",
      "type": "narration",
      "text": "ฉันถามอายะว่า"
    },
    {
      "id": "b276",
      "type": "dialogue",
      "text": "\"จากตรงนี้",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b277",
      "type": "dialogue",
      "text": "จะไปแยกกันไหม?\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b278",
      "type": "dialogue",
      "text": "\"ไม่เป็นไรหรอก\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b279",
      "type": "narration",
      "text": "อายะตอบอย่างไม่ใส่ใจ"
    },
    {
      "id": "b280",
      "type": "narration",
      "text": "เธอพยายามทำสีหน้าสบายๆ"
    },
    {
      "id": "b281",
      "type": "narration",
      "text": "แต่สีหน้าของเธอก็ตึงเครียด"
    },
    {
      "id": "b282",
      "type": "narration",
      "text": "แต่ความกังวลนั้นไร้ประโยชน์"
    },
    {
      "id": "b283",
      "type": "dialogue",
      "text": "\"อายะ อรุณสวัสดิ์~",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b284",
      "type": "dialogue",
      "text": "โอ้ โบยัน อรุณสวัสดิ์~!\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b285",
      "type": "dialogue",
      "text": "\"อายะ~",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b286",
      "type": "dialogue",
      "text": "โบยันด้วย",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b287",
      "type": "dialogue",
      "text": "ในที่สุดก็วันแรกแล้วสินะ~!\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b288",
      "type": "dialogue",
      "text": "\"โอ้",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b289",
      "type": "dialogue",
      "text": "โบยันมาแต่เช้าเลย!\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b290",
      "type": "dialogue",
      "text": "\"ไง",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b291",
      "type": "dialogue",
      "text": "โบยัน...",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b292",
      "type": "dialogue",
      "text": "มาเร็วดีนี่\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b293",
      "type": "narration",
      "text": "เพื่อนร่วมชั้นที่เห็นเรา"
    },
    {
      "id": "b294",
      "type": "narration",
      "text": "ก็ทักทายด้วยรอยยิ้ม"
    },
    {
      "id": "b295",
      "type": "narration",
      "text": "ไม่มีสายตาที่สงสัยเราเลย"
    },
    {
      "id": "b296",
      "type": "narration",
      "text": "ทุกคนมีความเชื่อมั่นในตัวฉัน"
    },
    {
      "id": "b297",
      "type": "narration",
      "text": "ที่ถูกเรียกว่า "
    },
    {
      "id": "b298",
      "type": "narration",
      "text": "\"คนน่าเชื่อถือ\""
    },
    {
      "id": "b299",
      "type": "narration",
      "text": "และอายะที่ถูกเรียกว่า "
    },
    {
      "id": "b300",
      "type": "narration",
      "text": "\"คู่รักนกเป็ดน้ำ\""
    },
    {
      "id": "b301",
      "type": "narration",
      "text": " กับโทกิตะ"
    },
    {
      "id": "b302",
      "type": "narration",
      "text": "ถึงแม้ฉันกับอายะ"
    },
    {
      "id": "b303",
      "type": "narration",
      "text": "ที่เป็นเพื่อนสมัยเด็ก"
    },
    {
      "id": "b304",
      "type": "narration",
      "text": "จะมาโรงเรียนด้วยกัน"
    },
    {
      "id": "b305",
      "type": "narration",
      "text": "แต่ก็ไม่มีใครคิดอะไร"
    },
    {
      "id": "b306",
      "type": "narration",
      "text": "ในตอนนี้"
    },
    {
      "id": "b307",
      "type": "narration",
      "text": "เรากลายเป็นกลุ่มคนที่มีชีวิตชีวาในทันที"
    },
    {
      "id": "b308",
      "type": "narration",
      "text": "แล้วก็ขึ้นรถไฟ"
    },
    {
      "id": "b309",
      "type": "narration",
      "text": "อายะหัวเราะอย่างสนุกสนานกับเพื่อนผู้หญิง"
    },
    {
      "id": "b310",
      "type": "narration",
      "text": "ส่วนฉันก็มองดูทิวทัศน์นอกหน้าต่างอย่างเหม่อลอย"
    },
    {
      "id": "b311",
      "type": "narration",
      "text": "นี่คือชีวิตประจำวันของเรา"
    },
    {
      "id": "b312",
      "type": "narration",
      "text": "แต่ชีวิตประจำวันนี้"
    },
    {
      "id": "b313",
      "type": "narration",
      "text": "จะจบลงในงานโรงเรียนนี้"
    },
    {
      "id": "b314",
      "type": "narration",
      "text": "เราลงจากรถไฟที่สถานีแรก"
    },
    {
      "id": "b315",
      "type": "narration",
      "text": "แล้วก็เดินไปตามถนนสายสั้นๆ ไปยังโรงเรียน"
    },
    {
      "id": "b316",
      "type": "narration",
      "text": "เมื่อถึงหน้าประตูโรงเรียน"
    },
    {
      "id": "b317",
      "type": "narration",
      "text": "ฉันก็เห็นซุ้มโค้ง"
    },
    {
      "id": "b318",
      "type": "narration",
      "text": "ที่เขียนว่า "
    },
    {
      "id": "b319",
      "type": "narration",
      "text": "\"ยินดีต้อนรับสู่งานโรงเรียน\""
    },
    {
      "id": "b320",
      "type": "narration",
      "text": "เราเดินลอดซุ้มนั้น"
    },
    {
      "id": "b321",
      "type": "narration",
      "text": "และเดินไปที่อาคารเรียน"
    },
    {
      "id": "b322",
      "type": "narration",
      "text": "ท่ามกลางนักเรียนที่ดูตื่นเต้น"
    },
    {
      "id": "b323",
      "type": "narration",
      "text": "ทุกคนดูเหมือนจะลอยไปกับความรู้สึกที่แปลกประหลาด"
    },
    {
      "id": "b324",
      "type": "narration",
      "text": "ฉันกับอายะ"
    },
    {
      "id": "b325",
      "type": "narration",
      "text": "ก็ดูแปลกๆ ตั้งแต่เช้าแล้ว"
    },
    {
      "id": "b326",
      "type": "narration",
      "text": "เหมือนกับตอนไปทัศนศึกษา"
    },
    {
      "id": "b327",
      "type": "narration",
      "text": "เป็นความรู้สึกว่า"
    },
    {
      "id": "b328",
      "type": "narration",
      "text": "ช่วงเวลาที่ไม่ธรรมดาจะเริ่มต้นขึ้น"
    },
    {
      "id": "b329",
      "type": "narration",
      "text": "เมื่อเราถึงหน้าห้องเรียน"
    },
    {
      "id": "b330",
      "type": "narration",
      "text": "ที่กลายเป็นบ้านผีสิง"
    },
    {
      "id": "b331",
      "type": "narration",
      "text": "อายะและเพื่อนๆ ก็เดินเข้าไปข้างใน"
    },
    {
      "id": "b332",
      "type": "narration",
      "text": "ส่วนฉัน"
    },
    {
      "id": "b333",
      "type": "narration",
      "text": "ไม่มีหน้าที่อะไร"
    },
    {
      "id": "b334",
      "type": "narration",
      "text": "ก็เลยต้องเดินไปเรื่อยๆ เพื่อฆ่าเวลา"
    },
    {
      "id": "b335",
      "type": "narration",
      "text": "ทันใดนั้น"
    },
    {
      "id": "b336",
      "type": "narration",
      "text": "ผมสั้นสีน้ำตาลของอายะ"
    },
    {
      "id": "b337",
      "type": "narration",
      "text": "ที่กำลังจะเข้าห้องเรียน"
    },
    {
      "id": "b338",
      "type": "narration",
      "text": "ก็หยุดนิ่ง"
    },
    {
      "id": "b339",
      "type": "narration",
      "text": "เธอถอยหลังมาครึ่งก้าว"
    },
    {
      "id": "b340",
      "type": "narration",
      "text": "แล้วหันมาหาฉัน"
    },
    {
      "id": "b341",
      "type": "dialogue",
      "text": "\"เจอกันนะ\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b342",
      "type": "dialogue",
      "text": "\"อื้ม",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b343",
      "type": "dialogue",
      "text": "สู้ๆ\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b344",
      "type": "narration",
      "text": "อายะโบกมือเบาๆ"
    },
    {
      "id": "b345",
      "type": "narration",
      "text": "แล้วก็เดินเข้าไปในห้องเรียน"
    },
    {
      "id": "b346",
      "type": "narration",
      "text": "วันแรกของงานโรงเรียน"
    },
    {
      "id": "b347",
      "type": "narration",
      "text": "จัดขึ้นในวันศุกร์"
    },
    {
      "id": "b348",
      "type": "narration",
      "text": "ดังนั้นในโรงเรียน"
    },
    {
      "id": "b349",
      "type": "narration",
      "text": "จึงมีแค่นักเรียนของเรา"
    },
    {
      "id": "b350",
      "type": "narration",
      "text": "กับผู้ปกครองบางส่วน"
    },
    {
      "id": "b351",
      "type": "narration",
      "text": "เด็กเล็กๆ"
    },
    {
      "id": "b352",
      "type": "narration",
      "text": "และคนที่ว่างงานในละแวกใกล้เคียง"
    },
    {
      "id": "b353",
      "type": "narration",
      "text": "แขกที่มาไม่เยอะมาก"
    },
    {
      "id": "b354",
      "type": "narration",
      "text": "ดังนั้นทุกร้านและทุกการแสดง"
    },
    {
      "id": "b355",
      "type": "narration",
      "text": "จึงมีบรรยากาศที่สงบ"
    },
    {
      "id": "b356",
      "type": "narration",
      "text": "ของจริงจะเริ่มในวันพรุ่งนี้"
    },
    {
      "id": "b357",
      "type": "narration",
      "text": "ซึ่งเป็นวันที่สองของงานโรงเรียน"
    },
    {
      "id": "b358",
      "type": "narration",
      "text": "ที่ผู้คนจะมากันแน่นขนัด"
    },
    {
      "id": "b359",
      "type": "narration",
      "text": "ฉันก็เลยเดินไปรอบๆ โรงเรียนตั้งแต่เช้า"
    },
    {
      "id": "b360",
      "type": "narration",
      "text": "แล้วก็นั่งเหม่อๆ บนม้านั่งเพื่อฆ่าเวลา"
    },
    {
      "id": "b361",
      "type": "narration",
      "text": "แล้วก็มีผู้หญิงคนหนึ่ง"
    },
    {
      "id": "b362",
      "type": "narration",
      "text": "ที่มีผมสีดำยาวปานกลาง"
    },
    {
      "id": "b363",
      "type": "narration",
      "text": "และดูจริงจัง"
    },
    {
      "id": "b364",
      "type": "narration",
      "text": "เดินเข้ามาหาฉัน"
    },
    {
      "id": "b365",
      "type": "dialogue",
      "text": "\"โบยัน...",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b366",
      "type": "dialogue",
      "text": "ที่ให้รอนาน\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b367",
      "type": "narration",
      "text": "ยูคาริยืนอยู่ตรงหน้าฉัน"
    },
    {
      "id": "b368",
      "type": "narration",
      "text": "แล้วก็ยิ้มอย่างสดใส"
    },
    {
      "id": "b369",
      "type": "dialogue",
      "text": "\"บ้านผีสิง",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b370",
      "type": "dialogue",
      "text": "ไม่เป็นไรแล้วเหรอ?\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b371",
      "type": "dialogue",
      "text": "\"อื้ม...",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b372",
      "type": "dialogue",
      "text": "แอบออกมาแล้ว\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b373",
      "type": "dialogue",
      "text": "\"เหรอ\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b374",
      "type": "dialogue",
      "text": "\"งั้น... ไปเดินเล่นกันไหม?\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b375",
      "type": "dialogue",
      "text": "\"แค่ช่วงเช้านะ\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b376",
      "type": "dialogue",
      "text": "\"ค่าา...",
      "speakerId": "yukari",
      "speakerName": "ยูคาริ"
    },
    {
      "id": "b377",
      "type": "dialogue",
      "text": "เข้าใจแล้วค่ะ~\"",
      "speakerId": "yukari",
      "speakerName": "ยูคาริ"
    },
    {
      "id": "b378",
      "type": "narration",
      "text": "ยูคาริพูดอย่างสบายๆ"
    },
    {
      "id": "b379",
      "type": "narration",
      "text": "ฉันค่อยๆ ลุกขึ้น"
    },
    {
      "id": "b380",
      "type": "narration",
      "text": "แล้วก็เดินตามยูคาริไป"
    },
    {
      "id": "b381",
      "type": "narration",
      "text": "ฉันมองดูนาฬิกาในสมาร์ทโฟน"
    },
    {
      "id": "b382",
      "type": "narration",
      "text": "พบว่าตอนนี้สิบโมงกว่าแล้ว"
    },
    {
      "id": "b383",
      "type": "narration",
      "text": "หน้าที่จับข้อเท้าของอายะ"
    },
    {
      "id": "b384",
      "type": "narration",
      "text": "จะเสร็จในอีกประมาณสองชั่วโมง"
    },
    {
      "id": "b385",
      "type": "narration",
      "text": "แต่ฉัน"
    },
    {
      "id": "b386",
      "type": "narration",
      "text": "รู้สึกว่าเวลาที่อยู่กับยูคาริ"
    },
    {
      "id": "b387",
      "type": "narration",
      "text": "คงจะไม่นานขนาดนั้น"
    },
    {
      "id": "b388",
      "type": "narration",
      "text": "ท่านใดสนใจสามารถกด Follow Page ผมไว้ได้นะครับ"
    },
    {
      "id": "b389",
      "type": "narration",
      "text": "บางเรื่องจะลงในเพจก่อนลงใน Neko นะครับ"
    },
    {
      "id": "b390",
      "type": "narration",
      "text": "ต้องมีอะไรสนุกๆเกิดขึ้นแน่ๆ"
    },
    {
      "id": "b391",
      "type": "narration",
      "text": "อยากจบสวยต้องควบสองนะโบยัน"
    }
  ]
}

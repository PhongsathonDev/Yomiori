{
  "id": "ch-19",
  "novelId": "boyish-friend",
  "chapterNumber": 19,
  "title": "Ch.19 — บทงานวัฒนธรรม - เกิดความกระอักกระอ่วนใจกับเพื่อนสมัยเด็กที่น่ารัก (วันที่ 12 อังคาร เย็น)",
  "novelTitle": "[18+] เรื่องราวของการพรากเพื่อนสนิทสาวที่น่ารักอันดับสองในห้อง มาเป็นของตัวเองด้วยทริปทัศนศึกษาสองคืนสามวัน",
  "blocks": [
    {
      "id": "b1",
      "type": "narration",
      "text": "ความอึดอัด = ความรักหวานชื่น"
    },
    {
      "id": "b2",
      "type": "narration",
      "text": "เมื่อเห็นอายะที่กำลังจมดิ่งลงในความสุข"
    },
    {
      "id": "b3",
      "type": "narration",
      "text": "ฉันก็ถึงขีดจำกัดเหมือนกัน"
    },
    {
      "id": "b4",
      "type": "narration",
      "text": "ฉันค่อยๆ ปล่อยตัวอายะให้พิงกับประตู"
    },
    {
      "id": "b5",
      "type": "narration",
      "text": "แล้วก็ดึงมือซ้ายที่เปื้อนสารคัดหลั่งออกจากช่องคลอด"
    },
    {
      "id": "b6",
      "type": "narration",
      "text": "และจับกางเกงของตัวเอง"
    },
    {
      "id": "b7",
      "type": "narration",
      "text": "ในท่าคุกเข่า"
    },
    {
      "id": "b8",
      "type": "narration",
      "text": "ฉันก็ปลดเข็มขัด"
    },
    {
      "id": "b9",
      "type": "narration",
      "text": "และรูดกางเกงลงพร้อมกับกางเกงใน"
    },
    {
      "id": "b10",
      "type": "narration",
      "text": "ส่วนที่แข็งและตั้งขึ้นก็กระเด้งออกมา"
    },
    {
      "id": "b11",
      "type": "narration",
      "text": "ช่วงล่างรู้สึกเย็นสบายขึ้นในทันที"
    },
    {
      "id": "b12",
      "type": "narration",
      "text": "แต่ตรงเป้าของฉันกลับร้อนเหมือนไฟ"
    },
    {
      "id": "b13",
      "type": "narration",
      "text": "มันเต้นตุบๆ"
    },
    {
      "id": "b14",
      "type": "narration",
      "text": "และมีของเหลวใสๆ ไหลออกมาจากปลายหัว"
    },
    {
      "id": "b15",
      "type": "narration",
      "text": "ทำให้ส่วนปลายเปียกชื้น"
    },
    {
      "id": "b16",
      "type": "narration",
      "text": "อายะที่ยังคงเคลิ้มไปกับความสุข"
    },
    {
      "id": "b17",
      "type": "narration",
      "text": "จ้องมองมาที่สิ่งที่อยู่ตรงหน้าเธอ"
    },
    {
      "id": "b18",
      "type": "narration",
      "text": "แล้ว..."
    },
    {
      "id": "b19",
      "type": "narration",
      "text": "เธอก็ยื่นมือออกมา"
    },
    {
      "id": "b20",
      "type": "narration",
      "text": "และจับแท่งเนื้อของฉันอย่างอ่อนโยน"
    },
    {
      "id": "b21",
      "type": "dialogue",
      "text": "\"อ๊ะ... อายะ...!\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b22",
      "type": "narration",
      "text": "ฉันขยับตัวโดยไม่รู้ตัว"
    },
    {
      "id": "b23",
      "type": "narration",
      "text": "ฉันไม่เข้าใจภาพที่อยู่ตรงหน้า"
    },
    {
      "id": "b24",
      "type": "narration",
      "text": "อายะกำลังจับแท่งเนื้อของฉัน"
    },
    {
      "id": "b25",
      "type": "narration",
      "text": "กระแสไฟฟ้าวิ่งไปทั่วกระดูกสันหลังของฉัน"
    },
    {
      "id": "b26",
      "type": "narration",
      "text": "อายะใช้ฝ่ามือลูบแท่งเนื้อของฉันทั้งหมด"
    },
    {
      "id": "b27",
      "type": "narration",
      "text": "และใช้นิ้วโป้งเล่นกับเส้นประสาทด้านล่าง"
    },
    {
      "id": "b28",
      "type": "narration",
      "text": "ความรู้สึกนุ่มนวลจากมือของเธอที่ลูบเบาๆ"
    },
    {
      "id": "b29",
      "type": "narration",
      "text": "ทำให้ความสุขพุ่งขึ้นไปทั่วร่างกาย"
    },
    {
      "id": "b30",
      "type": "narration",
      "text": "ท่ามกลางความมึนงง"
    },
    {
      "id": "b31",
      "type": "narration",
      "text": "หัวใจของอายะก็ส่งความรู้สึกมาให้ฉัน"
    },
    {
      "id": "b32",
      "type": "narration",
      "text": "---ของโบยัน... แข็งจัง"
    },
    {
      "id": "b33",
      "type": "narration",
      "text": "มันเต้นตุบๆ"
    },
    {
      "id": "b34",
      "type": "narration",
      "text": "ถ้าฉันสัมผัส... จะรู้สึกดีไหมนะ"
    },
    {
      "id": "b35",
      "type": "narration",
      "text": "สีหน้าของโบยัน"
    },
    {
      "id": "b36",
      "type": "narration",
      "text": "ดูมีความสุขจัง"
    },
    {
      "id": "b37",
      "type": "narration",
      "text": "สิ่งนี้... จะเข้ามาอยู่ในตัวฉัน"
    },
    {
      "id": "b38",
      "type": "narration",
      "text": "เข้ามาแล้วนะ"
    },
    {
      "id": "b39",
      "type": "narration",
      "text": "อายะค่อยๆ คุกเข่า"
    },
    {
      "id": "b40",
      "type": "narration",
      "text": "และขยับเข้ามาใกล้เป้ากางเกงของฉัน"
    },
    {
      "id": "b41",
      "type": "narration",
      "text": "---ยูคาริเคยบอกไว้"
    },
    {
      "id": "b42",
      "type": "narration",
      "text": "ว่าถ้าใช้ปาก"
    },
    {
      "id": "b43",
      "type": "narration",
      "text": "ผู้ชายจะรู้สึกดีมากๆ"
    },
    {
      "id": "b44",
      "type": "narration",
      "text": "โบยันก็"
    },
    {
      "id": "b45",
      "type": "narration",
      "text": "เป็นแบบนั้นด้วยเหรอ"
    },
    {
      "id": "b46",
      "type": "narration",
      "text": "อายะเผยอปากเล็กน้อย"
    },
    {
      "id": "b47",
      "type": "narration",
      "text": "แล้วก็เอาปากมาจูบที่ปลายหัว"
    },
    {
      "id": "b48",
      "type": "dialogue",
      "text": "\"อึ้ม\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b49",
      "type": "narration",
      "text": "เป้ากางเกงของฉันสั่นด้วยความสุขที่มากมายเกินไป"
    },
    {
      "id": "b50",
      "type": "narration",
      "text": "ริมฝีปากที่อ่อนนุ่มกดทับลงบนเส้นประสาทด้านล่าง"
    },
    {
      "id": "b51",
      "type": "narration",
      "text": "ขณะที่กดไว้"
    },
    {
      "id": "b52",
      "type": "narration",
      "text": "เธอก็เปิดและปิดริมฝีปาก"
    },
    {
      "id": "b53",
      "type": "narration",
      "text": "ในจังหวะที่เธอจูบเบาๆ"
    },
    {
      "id": "b54",
      "type": "narration",
      "text": "ความรู้สึกที่อยากจะหลั่งอสุจิก็พุ่งขึ้นมาจากอัณฑะ"
    },
    {
      "id": "b55",
      "type": "narration",
      "text": "บางสิ่งที่นุ่มและอบอุ่น"
    },
    {
      "id": "b56",
      "type": "narration",
      "text": "เลื่อนไปบนส่วนปลาย"
    },
    {
      "id": "b57",
      "type": "narration",
      "text": "อายะแลบปลายลิ้นออกมาจากริมฝีปาก"
    },
    {
      "id": "b58",
      "type": "narration",
      "text": "และเลียอย่างระมัดระวัง"
    },
    {
      "id": "b59",
      "type": "narration",
      "text": "เหมือนกำลังพยายามทำความเข้าใจอะไรบางอย่าง"
    },
    {
      "id": "b60",
      "type": "narration",
      "text": "สมองของฉันยังคงมึนงงจากภาพที่ไม่น่าเชื่อนี้"
    },
    {
      "id": "b61",
      "type": "narration",
      "text": "อายะคุกเข่าอยู่"
    },
    {
      "id": "b62",
      "type": "narration",
      "text": "และกำลังเลียแท่งเนื้อของฉัน"
    },
    {
      "id": "b63",
      "type": "narration",
      "text": "หรือก็คือ 'เฟลลาชิโอ'"
    },
    {
      "id": "b64",
      "type": "narration",
      "text": "แค่ภาพนี้อย่างเดียว"
    },
    {
      "id": "b65",
      "type": "narration",
      "text": "ก็ทำให้ฉันเกือบจะหลั่งออกมาแล้ว"
    },
    {
      "id": "b66",
      "type": "narration",
      "text": "นี่เป็นภาพที่ฉันไม่เคยแสดงให้ใครเห็น"
    },
    {
      "id": "b67",
      "type": "narration",
      "text": "และเป็นภาพที่ฉันเคยทำได้แค่จินตนาการเท่านั้น"
    },
    {
      "id": "b68",
      "type": "narration",
      "text": "อายะกำลังแลบลิ้นไปบนอวัยวะเพศของฉัน"
    },
    {
      "id": "b69",
      "type": "narration",
      "text": "โดยที่เสื้อและเสื้อชั้นในถูกดึงขึ้น"
    },
    {
      "id": "b70",
      "type": "narration",
      "text": "เผยให้เห็นหน้าอกสีขาว"
    },
    {
      "id": "b71",
      "type": "narration",
      "text": "เนื่องจากเราทั้งคู่อยู่ในท่าคุกเข่า"
    },
    {
      "id": "b72",
      "type": "narration",
      "text": "อายะจึงโน้มตัวไปข้างหน้าเล็กน้อย"
    },
    {
      "id": "b73",
      "type": "narration",
      "text": "ทำให้หน้าอกที่สวยงามของเธอคล้อยลง"
    },
    {
      "id": "b74",
      "type": "narration",
      "text": "ความรู้สึกในใจของอายะ"
    },
    {
      "id": "b75",
      "type": "narration",
      "text": "ส่งผ่านมาทางมือที่กำอวัยวะเพศของฉัน"
    },
    {
      "id": "b76",
      "type": "narration",
      "text": "และลิ้นที่เลียส่วนปลาย"
    },
    {
      "id": "b77",
      "type": "narration",
      "text": "---ได้กลิ่นของโบยัน"
    },
    {
      "id": "b78",
      "type": "narration",
      "text": "เป็นกลิ่นที่ทำให้ใจเต้นแรง"
    },
    {
      "id": "b79",
      "type": "narration",
      "text": "แบบนี้ใช่ไหมนะ"
    },
    {
      "id": "b80",
      "type": "narration",
      "text": "โบยัน... รู้สึกดีไหม?"
    },
    {
      "id": "b81",
      "type": "narration",
      "text": "แล้วตรงนี้ล่ะ... รู้สึกยังไง"
    },
    {
      "id": "b82",
      "type": "narration",
      "text": "โบยัน... ดูเหมือนจะเจ็บปวดนะ"
    },
    {
      "id": "b83",
      "type": "narration",
      "text": "น่ารักจัง"
    },
    {
      "id": "b84",
      "type": "narration",
      "text": "รู้สึกดีสินะ"
    },
    {
      "id": "b85",
      "type": "narration",
      "text": "ดีจัง"
    },
    {
      "id": "b86",
      "type": "narration",
      "text": "อายะบางครั้งก็เงยหน้าขึ้นมามองสีหน้าของฉัน"
    },
    {
      "id": "b87",
      "type": "narration",
      "text": "และดูเหมือนจะพยายามหาวิธีที่จะทำให้ฉันรู้สึกดี"
    },
    {
      "id": "b88",
      "type": "narration",
      "text": "เธอบีบปลายหัวด้วยริมฝีปากของเธอ"
    },
    {
      "id": "b89",
      "type": "narration",
      "text": "แล้วก็ดูด 'จุ๊บ'"
    },
    {
      "id": "b90",
      "type": "narration",
      "text": "แต่บางครั้ง"
    },
    {
      "id": "b91",
      "type": "narration",
      "text": "เธอก็ใช้ปลายลิ้นเลียไปที่รอยหยักรอบหัว"
    },
    {
      "id": "b92",
      "type": "narration",
      "text": "เป็นการใช้ปากอย่างน่าหงุดหงิด"
    },
    {
      "id": "b93",
      "type": "narration",
      "text": "มันทั้งจั๊กจี้ ทั้งรู้สึกดี และน่าหงุดหงิด"
    },
    {
      "id": "b94",
      "type": "narration",
      "text": "ฉันใกล้จะถึงขีดจำกัดแล้ว"
    },
    {
      "id": "b95",
      "type": "narration",
      "text": "ความรู้สึกที่อายะมอบให้"
    },
    {
      "id": "b96",
      "type": "narration",
      "text": "กับความรู้สึกในใจที่ส่งมาให้"
    },
    {
      "id": "b97",
      "type": "narration",
      "text": "ทำให้หัวของฉันแทบจะระเบิดออกมา"
    },
    {
      "id": "b98",
      "type": "dialogue",
      "text": "\"อึ้ม...!\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b99",
      "type": "narration",
      "text": "ความรู้สึกที่อยากจะหลั่งออกมาพุ่งเข้ามา"
    },
    {
      "id": "b100",
      "type": "narration",
      "text": "และทำให้เอวของฉันแทบจะทรุดลง"
    },
    {
      "id": "b101",
      "type": "narration",
      "text": "ฉันไม่สามารถคุกเข่าได้อีกแล้ว"
    },
    {
      "id": "b102",
      "type": "narration",
      "text": "ฉันจึงนั่งลงในท่าแบบญี่ปุ่น"
    },
    {
      "id": "b103",
      "type": "narration",
      "text": "แล้วอายะก็โน้มตัวเข้ามาหาฉัน"
    },
    {
      "id": "b104",
      "type": "narration",
      "text": "เธอนั่งในท่าคลาน"
    },
    {
      "id": "b105",
      "type": "narration",
      "text": "แล้วก็เอาปากครอบอวัยวะเพศของฉัน"
    },
    {
      "id": "b106",
      "type": "dialogue",
      "text": "\"ห๊ะ...\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b107",
      "type": "narration",
      "text": "ความรู้สึกที่ส่วนปลายถูกห่อหุ้มด้วยเยื่อเมือกที่อ่อนนุ่ม"
    },
    {
      "id": "b108",
      "type": "narration",
      "text": "มันทั้งร้อนและลื่น"
    },
    {
      "id": "b109",
      "type": "narration",
      "text": "ลิ้นของอายะที่เหมือนสิ่งมีชีวิตที่ไม่มีกระดูก"
    },
    {
      "id": "b110",
      "type": "narration",
      "text": "พันรอบปลายหัวของฉัน"
    },
    {
      "id": "b111",
      "type": "narration",
      "text": "เมื่อฉันรู้ว่านั่นคือปากของอายะ"
    },
    {
      "id": "b112",
      "type": "narration",
      "text": "ฉันก็แทบจะลอยขึ้นไปแล้ว"
    },
    {
      "id": "b113",
      "type": "narration",
      "text": "ฉันพยายามตั้งสติโดยการจดจ่อที่สายตา"
    },
    {
      "id": "b114",
      "type": "narration",
      "text": "ด้านล่างของฉัน"
    },
    {
      "id": "b115",
      "type": "narration",
      "text": "ฉันเห็นท้ายทอยของอายะ"
    },
    {
      "id": "b116",
      "type": "narration",
      "text": "ถัดไปฉันเห็นเสื้อที่ถูกดึงขึ้นและแผ่นหลังที่ชื้นเหงื่อ"
    },
    {
      "id": "b117",
      "type": "narration",
      "text": "กระโปรงของเธอก็เลื่อนขึ้นมา"
    },
    {
      "id": "b118",
      "type": "narration",
      "text": "เผยให้เห็นขอบกางเกงในสีฟ้าอ่อน"
    },
    {
      "id": "b119",
      "type": "narration",
      "text": "ลิ้นของอายะเคลื่อนขึ้นลงบนเส้นประสาทด้านล่าง"
    },
    {
      "id": "b120",
      "type": "narration",
      "text": "ดึงฉันกลับสู่ความรู้สึกทางเพศ"
    },
    {
      "id": "b121",
      "type": "narration",
      "text": "ก้นและต้นขาของฉันเกร็ง"
    },
    {
      "id": "b122",
      "type": "narration",
      "text": "และรู้สึกเหมือนทวารหนักกำลังหดตัว"
    },
    {
      "id": "b123",
      "type": "narration",
      "text": "เป็นความรู้สึกที่ใกล้จะหลั่งออกมาแล้ว"
    },
    {
      "id": "b124",
      "type": "narration",
      "text": "ความรู้สึกของอายะ"
    },
    {
      "id": "b125",
      "type": "narration",
      "text": "ส่งผ่านมาทางเยื่อเมือก"
    },
    {
      "id": "b126",
      "type": "narration",
      "text": "---ของโบยัน... พองขึ้น"
    },
    {
      "id": "b127",
      "type": "narration",
      "text": "ฉันรู้ว่ามันคืออะไร"
    },
    {
      "id": "b128",
      "type": "narration",
      "text": "มันเหมือนตอนที่อยู่ในตัวฉันเลย"
    },
    {
      "id": "b129",
      "type": "narration",
      "text": "มันจะออกมาแล้ว"
    },
    {
      "id": "b130",
      "type": "narration",
      "text": "ไม่เป็นไร... ออกมาเลย"
    },
    {
      "id": "b131",
      "type": "narration",
      "text": "ให้เยอะๆ เลย"
    },
    {
      "id": "b132",
      "type": "narration",
      "text": "ให้รู้สึกดีๆ เลยนะ"
    },
    {
      "id": "b133",
      "type": "narration",
      "text": "มันจะออกมาแล้ว"
    },
    {
      "id": "b134",
      "type": "narration",
      "text": "ความรู้สึกร้อนๆ พุ่งมาจากอัณฑะ"
    },
    {
      "id": "b135",
      "type": "narration",
      "text": "ราวกับถูกนำทางด้วยหัวใจของอายะ"
    },
    {
      "id": "b136",
      "type": "narration",
      "text": "ไม่ไหวแล้ว"
    },
    {
      "id": "b137",
      "type": "narration",
      "text": "อีกแล้ว"
    },
    {
      "id": "b138",
      "type": "dialogue",
      "text": "\"ไม่นะ... จะ... ออกมาแล้ว!\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b139",
      "type": "narration",
      "text": "ในวินาทีนั้น"
    },
    {
      "id": "b140",
      "type": "narration",
      "text": "กระแสไฟฟ้าก็แล่นไปทั่วร่างกายของฉัน"
    },
    {
      "id": "b141",
      "type": "narration",
      "text": "มันคือความรู้สึกที่เป็นอิสระและความสุขอย่างเหลือเชื่อ"
    },
    {
      "id": "b142",
      "type": "narration",
      "text": "บางสิ่งที่ร้อนๆ พุ่งออกมาจากก้นของฉันพร้อมกับความสุข"
    },
    {
      "id": "b143",
      "type": "narration",
      "text": "มันถูกยิงเข้าไปในปากของอายะ"
    },
    {
      "id": "b144",
      "type": "narration",
      "text": "'ปุด... ปุด...'"
    },
    {
      "id": "b145",
      "type": "narration",
      "text": "น้ำอสุจิของฉันกำลังทำให้ปากของอายะแปดเปื้อน"
    },
    {
      "id": "b146",
      "type": "narration",
      "text": "มันรู้สึกดี"
    },
    {
      "id": "b147",
      "type": "narration",
      "text": "ฉันอยากจะปล่อยออกมาอีก"
    },
    {
      "id": "b148",
      "type": "dialogue",
      "text": "\"อื้มมม...!\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b149",
      "type": "narration",
      "text": "อายะส่งเสียงที่อู้อี้ออกมา"
    },
    {
      "id": "b150",
      "type": "narration",
      "text": "ไหล่ของเธอสั่นกระตุก"
    },
    {
      "id": "b151",
      "type": "narration",
      "text": "ฉันดันไหล่ของอายะไว้โดยไม่รู้ตัว"
    },
    {
      "id": "b152",
      "type": "narration",
      "text": "ไม่ดีแล้ว"
    },
    {
      "id": "b153",
      "type": "narration",
      "text": "ฉันรีบปล่อยมือ"
    },
    {
      "id": "b154",
      "type": "narration",
      "text": "หลังจากนั้น"
    },
    {
      "id": "b155",
      "type": "narration",
      "text": "หัวของอายะก็เงยขึ้นเล็กน้อย"
    },
    {
      "id": "b156",
      "type": "narration",
      "text": "'อื้ม... แค่ก...'"
    },
    {
      "id": "b157",
      "type": "narration",
      "text": "อายะไอ"
    },
    {
      "id": "b158",
      "type": "narration",
      "text": "ดูเหมือนว่าเธอจะปล่อยอวัยวะเพศของฉันแล้ว"
    },
    {
      "id": "b159",
      "type": "narration",
      "text": "จากการกระทำนั้น"
    },
    {
      "id": "b160",
      "type": "narration",
      "text": "อวัยวะเพศของฉันก็กระดอนขึ้นลง"
    },
    {
      "id": "b161",
      "type": "narration",
      "text": "'ปุด... ปุด...'"
    },
    {
      "id": "b162",
      "type": "narration",
      "text": "ของเหลวสีขาวขุ่นยังคงถูกยิงออกมา"
    },
    {
      "id": "b163",
      "type": "narration",
      "text": "และไปถูกหน้าของอายะที่กำลังมองลงไป"
    },
    {
      "id": "b164",
      "type": "narration",
      "text": "'อ๊ะ... ไม่นะ... อึ้ม...'"
    },
    {
      "id": "b165",
      "type": "narration",
      "text": "อายะส่งเสียงสับสนออกมา"
    },
    {
      "id": "b166",
      "type": "narration",
      "text": "เมื่อเธอยกหน้าขึ้น"
    },
    {
      "id": "b167",
      "type": "narration",
      "text": "มีคราบสีขาวติดอยู่"
    },
    {
      "id": "b168",
      "type": "narration",
      "text": "'อื้ม... แค่ก... อื้ม... อึ้ม...'"
    },
    {
      "id": "b169",
      "type": "narration",
      "text": "อายะกลืนสิ่งที่ติดคอเธอ"
    },
    {
      "id": "b170",
      "type": "narration",
      "text": "และส่งเสียงแปลกๆ ออกมา"
    },
    {
      "id": "b171",
      "type": "narration",
      "text": "เธอไอ"
    },
    {
      "id": "b172",
      "type": "narration",
      "text": "และน้ำอสุจิก็หยดจากมุมปากของเธอ"
    },
    {
      "id": "b173",
      "type": "narration",
      "text": "อายะใช้มือปิดปากไว้โดยอัตโนมัติ"
    },
    {
      "id": "b174",
      "type": "narration",
      "text": "แต่ก็มีน้ำหยดลงมาที่พื้นหนึ่งหยด"
    },
    {
      "id": "b175",
      "type": "narration",
      "text": "และอีกหนึ่งหยด"
    },
    {
      "id": "b176",
      "type": "narration",
      "text": "ฉันรู้สึกงงงวยกับภาพที่ลามกของอายะ"
    },
    {
      "id": "b177",
      "type": "narration",
      "text": "หายใจ... ไม่ออก"
    },
    {
      "id": "b178",
      "type": "narration",
      "text": "ส่วนล่างของฉันยังร้อนอยู่"
    },
    {
      "id": "b179",
      "type": "narration",
      "text": "และความรู้สึกดีๆ ก็ไม่หายไป"
    },
    {
      "id": "b180",
      "type": "narration",
      "text": "ฉันสับสน"
    },
    {
      "id": "b181",
      "type": "narration",
      "text": "ทั้งรู้สึกผิดที่ทำให้ใบหน้าของอายะเปื้อน"
    },
    {
      "id": "b182",
      "type": "narration",
      "text": "และรู้สึกมีชัยที่ได้ทำให้น้ำอสุจิของเธอดื่มลงไป"
    },
    {
      "id": "b183",
      "type": "narration",
      "text": "อายะเองก็ยังคงใช้มือปิดปากไว้"
    },
    {
      "id": "b184",
      "type": "narration",
      "text": "แล้วก็หันหน้าหนีไป"
    },
    {
      "id": "b185",
      "type": "narration",
      "text": "เราทั้งคู่หายใจหอบ"
    },
    {
      "id": "b186",
      "type": "narration",
      "text": "ห้องเตรียมอุปกรณ์ศิลปะที่มืดและชื้น"
    },
    {
      "id": "b187",
      "type": "narration",
      "text": "เต็มไปด้วยเสียงหายใจที่หนักหน่วงของเราสองคน"
    },
    {
      "id": "b188",
      "type": "narration",
      "text": "..."
    },
    {
      "id": "b189",
      "type": "narration",
      "text": "เราคงอยู่ในท่านี้ประมาณห้านาที"
    },
    {
      "id": "b190",
      "type": "narration",
      "text": "ฉัน... นั่งในท่าแบบญี่ปุ่น"
    },
    {
      "id": "b191",
      "type": "narration",
      "text": "โดยที่ส่วนล่างของฉันยังเปลือยเปล่า"
    },
    {
      "id": "b192",
      "type": "narration",
      "text": "ส่วนอายะ... ก็ยังคงเปลือยหน้าอกและใช้มือปิดปากไว้"
    },
    {
      "id": "b193",
      "type": "narration",
      "text": "ดวงตาของอายะสั่นไหว"
    },
    {
      "id": "b194",
      "type": "narration",
      "text": "แก้มของเธอแดงก่ำ"
    },
    {
      "id": "b195",
      "type": "narration",
      "text": "เธอน่าจะกลับมามีสติแล้ว"
    },
    {
      "id": "b196",
      "type": "narration",
      "text": "และกำลังทบทวนสิ่งที่เธอเพิ่งทำไป"
    },
    {
      "id": "b197",
      "type": "narration",
      "text": "สีหน้าของเธอบ่งบอกว่า 'อับอายแทบตาย'"
    },
    {
      "id": "b198",
      "type": "narration",
      "text": "ฉันก็รู้สึกอึดอัดเหมือนกัน"
    },
    {
      "id": "b199",
      "type": "narration",
      "text": "จนไม่สามารถพูดอะไรได้"
    },
    {
      "id": "b200",
      "type": "narration",
      "text": "ทันใดนั้น"
    },
    {
      "id": "b201",
      "type": "narration",
      "text": "ก็มีเสียงดังมาจากข้างนอก"
    },
    {
      "id": "b202",
      "type": "narration",
      "text": "เสียงฝีเท้าของคนหลายคนเข้ามาในห้องศิลปะ"
    },
    {
      "id": "b203",
      "type": "narration",
      "text": "พวกเขาคงจะมาเอาของบางอย่างในห้องเตรียมอุปกรณ์ศิลปะ"
    },
    {
      "id": "b204",
      "type": "narration",
      "text": "ฉันกับอายะมองตากัน"
    },
    {
      "id": "b205",
      "type": "narration",
      "text": "แล้วเราก็รีบจัดเสื้อผ้าของตัวเอง"
    },
    {
      "id": "b206",
      "type": "narration",
      "text": "ฉันที่ใส่กางเกงและกางเกงในกลับเข้าที่ก่อน"
    },
    {
      "id": "b207",
      "type": "narration",
      "text": "ก็มองไปรอบๆ ห้องเตรียมอุปกรณ์ศิลปะ"
    },
    {
      "id": "b208",
      "type": "narration",
      "text": "ฉันเห็นกล่องทิชชูเปียกบนชั้นที่สองของตู้"
    },
    {
      "id": "b209",
      "type": "narration",
      "text": "ฉันรีบคลานไปหยิบมัน"
    },
    {
      "id": "b210",
      "type": "dialogue",
      "text": "\"อายะ... หันมาหน่อย\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b211",
      "type": "narration",
      "text": "เมื่อฉันเดินเข้าไปหาอายะ"
    },
    {
      "id": "b212",
      "type": "narration",
      "text": "ฉันก็ใช้ทิชชูเปียกเช็ดของเหลวที่ติดอยู่บนหน้า"
    },
    {
      "id": "b213",
      "type": "narration",
      "text": "คาง และริมฝีปากของเธอ"
    },
    {
      "id": "b214",
      "type": "dialogue",
      "text": "\"อ๊ะ... ขอบใจนะ\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b215",
      "type": "dialogue",
      "text": "\"ออกไปกันเถอะ\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b216",
      "type": "narration",
      "text": "จากนั้น"
    },
    {
      "id": "b217",
      "type": "narration",
      "text": "ฉันก็เก็บกล่องสีที่กระจัดกระจายอยู่บนพื้น"
    },
    {
      "id": "b218",
      "type": "narration",
      "text": "แล้วเอาใส่ลงในกล่องที่ว่างๆ"
    },
    {
      "id": "b219",
      "type": "narration",
      "text": "ยังไม่มีใครเข้ามาในห้องนี้"
    },
    {
      "id": "b220",
      "type": "narration",
      "text": "สัญชาตญาณของฉันบอกแบบนั้น"
    },
    {
      "id": "b221",
      "type": "narration",
      "text": "แต่ฉันก็รีบเร่งอย่างแปลกๆ"
    },
    {
      "id": "b222",
      "type": "narration",
      "text": "ฉันถือกล่องสีประมาณสิบกล่องด้วยมือข้างเดียว"
    },
    {
      "id": "b223",
      "type": "narration",
      "text": "แล้วก็ยืนขึ้น"
    },
    {
      "id": "b224",
      "type": "narration",
      "text": "ฉันกำลังจะจับลูกบิดประตู"
    },
    {
      "id": "b225",
      "type": "narration",
      "text": "แต่ก็หยุดลง"
    },
    {
      "id": "b226",
      "type": "narration",
      "text": "ฉันหันกลับไปมอง"
    },
    {
      "id": "b227",
      "type": "narration",
      "text": "อายะทำหน้าเหมือน 'หืม?'"
    },
    {
      "id": "b228",
      "type": "narration",
      "text": "ฉันหยิบกล่องสีขึ้นมาหนึ่งกล่อง"
    },
    {
      "id": "b229",
      "type": "narration",
      "text": "แล้วส่งให้เธอ"
    },
    {
      "id": "b230",
      "type": "dialogue",
      "text": "\"ช่วยถือไว้กล่องหนึ่งได้ไหม?\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b231",
      "type": "dialogue",
      "text": "\"อ๊ะ... อื้ม...\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b232",
      "type": "narration",
      "text": "อายะกอดกล่องนั้นไว้เหมือนเป็นของมีค่า"
    },
    {
      "id": "b233",
      "type": "narration",
      "text": "..."
    },
    {
      "id": "b234",
      "type": "narration",
      "text": "ฉันเปิดประตูออก"
    },
    {
      "id": "b235",
      "type": "narration",
      "text": "และเราก็ออกมา"
    },
    {
      "id": "b236",
      "type": "narration",
      "text": "ในห้องศิลปะมีนักเรียนอยู่หลายคน"
    },
    {
      "id": "b237",
      "type": "narration",
      "text": "เป็นหน้าที่ฉันไม่คุ้นเคย"
    },
    {
      "id": "b238",
      "type": "narration",
      "text": "น่าจะอยู่คนละปีกับเรา"
    },
    {
      "id": "b239",
      "type": "narration",
      "text": "ฉันกับอายะทำหน้าเหมือน 'เรามาเอาสีในห้องเตรียมอุปกรณ์ศิลปะ'"
    },
    {
      "id": "b240",
      "type": "narration",
      "text": "แล้วเราก็ออกจากห้องศิลปะไป"
    },
    {
      "id": "b241",
      "type": "narration",
      "text": "เราเดินไปตามทางเดินอย่างเงียบๆ"
    },
    {
      "id": "b242",
      "type": "narration",
      "text": "มีนักเรียนหลายคนเดินสวนกับเรา"
    },
    {
      "id": "b243",
      "type": "narration",
      "text": "ดูเหมือนทุกคนจะยุ่งกับการเตรียมงานโรงเรียน"
    },
    {
      "id": "b244",
      "type": "dialogue",
      "text": "\"โบยัน... ขอโทษนะ... ฉันขอแวะเข้าห้องน้ำก่อน\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b245",
      "type": "dialogue",
      "text": "\"อ๊ะ... อื้ม...\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b246",
      "type": "narration",
      "text": "อายะกอดกล่องสีไว้แน่น"
    },
    {
      "id": "b247",
      "type": "narration",
      "text": "แล้วก็เดินเข้าไปในห้องน้ำหญิง"
    },
    {
      "id": "b248",
      "type": "narration",
      "text": "ขณะที่รออายะ"
    },
    {
      "id": "b249",
      "type": "narration",
      "text": "ฉันก็นึกถึงสิ่งที่เกิดขึ้นเมื่อครู่"
    },
    {
      "id": "b250",
      "type": "narration",
      "text": "มันรู้สึกเหมือนเป็นความฝัน"
    },
    {
      "id": "b251",
      "type": "narration",
      "text": "---ใจเย็นไว้"
    },
    {
      "id": "b252",
      "type": "narration",
      "text": "ไม่... ฉันใจเย็นแล้ว"
    },
    {
      "id": "b253",
      "type": "narration",
      "text": "แค่รู้สึกเหมือนกำลังลอยอยู่เท่านั้น"
    },
    {
      "id": "b254",
      "type": "narration",
      "text": "อายะคนนั้น..."
    },
    {
      "id": "b255",
      "type": "narration",
      "text": "ที่เอาหน้าซบเป้ากางเกงของฉัน..."
    },
    {
      "id": "b256",
      "type": "narration",
      "text": "ไม่ดีแล้ว"
    },
    {
      "id": "b257",
      "type": "narration",
      "text": "ฉันเพิ่งหลั่งไปแท้ๆ"
    },
    {
      "id": "b258",
      "type": "narration",
      "text": "แต่ส่วนล่างของฉันก็ร้อนขึ้นมาอีกแล้ว"
    },
    {
      "id": "b259",
      "type": "narration",
      "text": "---ทำใจให้ชิน"
    },
    {
      "id": "b260",
      "type": "narration",
      "text": "มันเป็นไปไม่ได้"
    },
    {
      "id": "b261",
      "type": "narration",
      "text": "มันต่างจากการมีเพศสัมพันธ์"
    },
    {
      "id": "b262",
      "type": "narration",
      "text": "เมื่อก่อน... ฉันเป็นคนบุก"
    },
    {
      "id": "b263",
      "type": "narration",
      "text": "แต่ไม่คิดเลยว่าอายะจะทำแบบนี้..."
    },
    {
      "id": "b264",
      "type": "narration",
      "text": "---สำหรับฉัน... มันเป็นเรื่องปกติ"
    },
    {
      "id": "b265",
      "type": "narration",
      "text": "---อย่าให้ถูกปั่นป่วน"
    },
    {
      "id": "b266",
      "type": "narration",
      "text": "ใช่แล้ว"
    },
    {
      "id": "b267",
      "type": "narration",
      "text": "การที่ฉันถูกอายะ..."
    },
    {
      "id": "b268",
      "type": "narration",
      "text": "เป็นเรื่องปกติ..."
    },
    {
      "id": "b269",
      "type": "narration",
      "text": "ไม่... ใจเย็นไว้"
    },
    {
      "id": "b270",
      "type": "narration",
      "text": "จนกว่าอายะจะเลิกกับโทกิตะ"
    },
    {
      "id": "b271",
      "type": "narration",
      "text": "และคบกับฉันอย่างเปิดเผย"
    },
    {
      "id": "b272",
      "type": "narration",
      "text": "ฉันต้องไม่ให้อายะปั่นป่วนฉัน"
    },
    {
      "id": "b273",
      "type": "dialogue",
      "text": "\"รอนานไหม...\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b274",
      "type": "narration",
      "text": "อายะกลับมา"
    },
    {
      "id": "b275",
      "type": "narration",
      "text": "โดยมองไปที่พื้นทางเดิน"
    },
    {
      "id": "b276",
      "type": "narration",
      "text": "ปลายผมของเธอเปียกเล็กน้อย"
    },
    {
      "id": "b277",
      "type": "narration",
      "text": "เธอคงจะบ้วนปากหรือล้างหน้า"
    },
    {
      "id": "b278",
      "type": "narration",
      "text": "มีบรรยากาศที่น่าอึดอัดเกิดขึ้น"
    },
    {
      "id": "b279",
      "type": "narration",
      "text": "ฉันรู้เหตุผลดี"
    },
    {
      "id": "b280",
      "type": "narration",
      "text": "เพราะฉันบังคับให้หัวใจของอายะเปิดออก"
    },
    {
      "id": "b281",
      "type": "narration",
      "text": "และปลดปล่อยความรู้สึกออกมา"
    },
    {
      "id": "b282",
      "type": "narration",
      "text": "หัวใจของอายะมอบตัวเองให้ฉัน"
    },
    {
      "id": "b283",
      "type": "narration",
      "text": "กำแพงระหว่างเราหายไป"
    },
    {
      "id": "b284",
      "type": "narration",
      "text": "และเราไม่รู้ว่าจะรักษาระยะห่างกันยังไง"
    },
    {
      "id": "b285",
      "type": "dialogue",
      "text": "\"ขอโทษนะ\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b286",
      "type": "narration",
      "text": "ฉันเผลอพูดขอโทษออกไป"
    },
    {
      "id": "b287",
      "type": "dialogue",
      "text": "\"อื้ม... มันขมเล็กน้อยนะ...\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b288",
      "type": "dialogue",
      "text": "\"ห๊ะ?\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b289",
      "type": "dialogue",
      "text": "\"เอ๊ะ... อ๊ะ...\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b290",
      "type": "narration",
      "text": "หน้าของอายะแดงขึ้นอีกครั้ง"
    },
    {
      "id": "b291",
      "type": "narration",
      "text": "ไม่ใช่ว่าฉันขอโทษเรื่องนั้น"
    },
    {
      "id": "b292",
      "type": "narration",
      "text": "เธอคงรู้แล้วว่าฉันไม่ได้ขอโทษเรื่องนั้น"
    },
    {
      "id": "b293",
      "type": "narration",
      "text": "---ทำใจให้ชิน"
    },
    {
      "id": "b294",
      "type": "narration",
      "text": "---ทำใจให้ชิน"
    },
    {
      "id": "b295",
      "type": "narration",
      "text": "---ทำใจให้ชิน"
    },
    {
      "id": "b296",
      "type": "narration",
      "text": "มันเป็นไปไม่ได้"
    },
    {
      "id": "b297",
      "type": "narration",
      "text": "ฉันไม่คิดว่าจะทำใจให้ชินกับความน่ารักของอายะได้เลย"
    },
    {
      "id": "b298",
      "type": "narration",
      "text": "ฉันอยากจะกอดเธออีกครั้ง"
    },
    {
      "id": "b299",
      "type": "narration",
      "text": "อยากจะจูบเธอในทันที"
    },
    {
      "id": "b300",
      "type": "narration",
      "text": "อย่างน้อยก็แค่จับมือ..."
    },
    {
      "id": "b301",
      "type": "narration",
      "text": "เราทั้งคู่เก็บความต้องการต่างๆ ไว้ในใจ"
    },
    {
      "id": "b302",
      "type": "narration",
      "text": "แล้วก็กลับไปที่ห้องเรียนเหมือนไม่มีอะไรเกิดขึ้น"
    },
    {
      "id": "b303",
      "type": "narration",
      "text": "ท่านใดสนใจสามารถกด Follow Page ผมไว้ได้นะครับ"
    },
    {
      "id": "b304",
      "type": "narration",
      "text": "บางเรื่องจะลงในเพจก่อนลงใน Neko นะครับ"
    },
    {
      "id": "b305",
      "type": "narration",
      "text": "อยากกิน MK เลยพรี่ชาย"
    },
    {
      "id": "b306",
      "type": "narration",
      "text": "โดนอายันฟลเคาต์เตอร์!!"
    }
  ]
}

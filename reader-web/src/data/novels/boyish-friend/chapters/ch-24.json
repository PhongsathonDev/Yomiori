{
  "id": "ch-24",
  "novelId": "boyish-friend",
  "chapterNumber": 24,
  "title": "Ch.24 — บทงานวัฒนธรรม - สารภาพรักกับเพื่อนสมัยเด็ก (วันที่ 14 พฤหัส ดึก)",
  "novelTitle": "[18+] เรื่องราวของการพรากเพื่อนสนิทสาวที่น่ารักอันดับสองในห้อง มาเป็นของตัวเองด้วยทริปทัศนศึกษาสองคืนสามวัน",
  "blocks": [
    {
      "id": "b1",
      "type": "narration",
      "text": "ฉันกับอายะกระตุกเป็นจังหวะเดียวกัน และหายใจหอบถี่เหมือนกัน"
    },
    {
      "id": "b2",
      "type": "narration",
      "text": "ฉันรู้สึกเหมือนกำลังถูกอายะกลืนกิน"
    },
    {
      "id": "b3",
      "type": "narration",
      "text": "เหมือนกับที่ฉันกลืนกินอายะซ้ำแล้วซ้ำเล่า"
    },
    {
      "id": "b4",
      "type": "narration",
      "text": "ไม่สิ นี่อาจเป็นความรู้สึกของอายะก็ได้"
    },
    {
      "id": "b5",
      "type": "narration",
      "text": "---รู้สึกดี"
    },
    {
      "id": "b6",
      "type": "narration",
      "text": "รู้สึกดี"
    },
    {
      "id": "b7",
      "type": "narration",
      "text": "อยากอยู่ด้วยกัน"
    },
    {
      "id": "b8",
      "type": "narration",
      "text": "ตลอดไป"
    },
    {
      "id": "b9",
      "type": "narration",
      "text": "ขอบเขตของสติเราหายไป"
    },
    {
      "id": "b10",
      "type": "narration",
      "text": "สิ่งที่ไหลเข้ามา"
    },
    {
      "id": "b11",
      "type": "narration",
      "text": "ฉันไม่รู้แล้วว่ามันเป็นความรู้สึกของใคร"
    },
    {
      "id": "b12",
      "type": "dialogue",
      "text": "\"อายะ...\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b13",
      "type": "narration",
      "text": "ฉันเรียกชื่ออายะ"
    },
    {
      "id": "b14",
      "type": "narration",
      "text": "เหมือนกับกำลังค้นหาสติของเธอ"
    },
    {
      "id": "b15",
      "type": "dialogue",
      "text": "\"โบยัน...\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b16",
      "type": "narration",
      "text": "เมื่อฉันได้ยินเสียงของอายะ"
    },
    {
      "id": "b17",
      "type": "narration",
      "text": "ในที่สุดฉันก็สัมผัสได้ถึงโครงร่างของร่างกายตัวเอง"
    },
    {
      "id": "b18",
      "type": "dialogue",
      "text": "\"โบยัน... ยังกระตุกอยู่เลย... ทำไม...?\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b19",
      "type": "narration",
      "text": "เมื่อเธอมากระซิบที่หู"
    },
    {
      "id": "b20",
      "type": "narration",
      "text": "ฉันก็รู้สึกเหมือนจะถึงจุดสุดยอดอีกครั้ง"
    },
    {
      "id": "b21",
      "type": "narration",
      "text": "ฉันดึงเอวของอายะเข้ามาใกล้"
    },
    {
      "id": "b22",
      "type": "narration",
      "text": "แล้วก็ฉีดน้ำอสุจิเข้าไปอย่างแรง"
    },
    {
      "id": "b23",
      "type": "narration",
      "text": "น้องชายของฉันกระตุก"
    },
    {
      "id": "b24",
      "type": "narration",
      "text": "ด้วยความรู้สึกดี"
    },
    {
      "id": "b25",
      "type": "narration",
      "text": "ในเวลาเดียวกัน"
    },
    {
      "id": "b26",
      "type": "narration",
      "text": "ร่างกายของอายะก็สั่นอย่างแรง"
    },
    {
      "id": "b27",
      "type": "dialogue",
      "text": "\"ฮ๊ะ... อู้ว~!\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b28",
      "type": "narration",
      "text": "ฉันรู้สึกได้ว่าอายะถึงจุดสุดยอดอีกครั้ง"
    },
    {
      "id": "b29",
      "type": "narration",
      "text": "ฉันบีบน้ำอสุจิที่เหลือทั้งหมด"
    },
    {
      "id": "b30",
      "type": "narration",
      "text": "ที่อยู่ในลูกอัณฑะและท่อปัสสาวะออกมา"
    },
    {
      "id": "b31",
      "type": "narration",
      "text": "เป็นการปลดปล่อยที่แห้ง"
    },
    {
      "id": "b32",
      "type": "narration",
      "text": "และแทบจะไม่มีของเหลวเลย"
    },
    {
      "id": "b33",
      "type": "narration",
      "text": "แต่มันให้ความรู้สึกดีอย่างไม่น่าเชื่อ"
    },
    {
      "id": "b34",
      "type": "narration",
      "text": "ฉันไม่รู้สึกถึงเวลา"
    },
    {
      "id": "b35",
      "type": "narration",
      "text": "ไม่รู้ว่าผ่านไปนานแค่ไหนแล้ว"
    },
    {
      "id": "b36",
      "type": "dialogue",
      "text": "\"ฮ้า... ฮ้า...\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b37",
      "type": "narration",
      "text": "ลมหายใจร้อนๆ ที่ไม่รู้ว่าเป็นของใคร"
    },
    {
      "id": "b38",
      "type": "narration",
      "text": "ดังก้องไปทั่ว"
    },
    {
      "id": "b39",
      "type": "narration",
      "text": "ฉันบรรจงจูบอายะ"
    },
    {
      "id": "b40",
      "type": "narration",
      "text": "เหมือนกับจะระบายความรักที่มีต่อเธอ"
    },
    {
      "id": "b41",
      "type": "narration",
      "text": "แก้มที่ร้อนผ่าว"
    },
    {
      "id": "b42",
      "type": "narration",
      "text": "เปลือกตาที่ปิดสนิท"
    },
    {
      "id": "b43",
      "type": "narration",
      "text": "หน้าผากที่ชื้นด้วยเหงื่อ"
    },
    {
      "id": "b44",
      "type": "narration",
      "text": "ริมฝีปากที่เปียกชื้น"
    },
    {
      "id": "b45",
      "type": "narration",
      "text": "ลำคอที่เรียวสวย"
    },
    {
      "id": "b46",
      "type": "narration",
      "text": "ไหปลาร้าที่สวยงาม"
    },
    {
      "id": "b47",
      "type": "narration",
      "text": "เต้านมที่นุ่มนวล"
    },
    {
      "id": "b48",
      "type": "narration",
      "text": "และหัวนมที่แข็งตัว..."
    },
    {
      "id": "b49",
      "type": "narration",
      "text": "\"จุ๊บ\""
    },
    {
      "id": "b50",
      "type": "narration",
      "text": " "
    },
    {
      "id": "b51",
      "type": "narration",
      "text": "\"จุ๊บ\""
    },
    {
      "id": "b52",
      "type": "narration",
      "text": " "
    },
    {
      "id": "b53",
      "type": "narration",
      "text": "\"จุ๊บ\""
    },
    {
      "id": "b54",
      "type": "narration",
      "text": "เสียงจูบดังขึ้นหลายสิบครั้ง"
    },
    {
      "id": "b55",
      "type": "narration",
      "text": "แม้ว่าเรื่องราวควรจะจบลงแล้ว"
    },
    {
      "id": "b56",
      "type": "narration",
      "text": "แต่ความรู้สึกก็เหมือนจะเริ่มต้นอีกครั้ง"
    },
    {
      "id": "b57",
      "type": "narration",
      "text": "ความต้องการทางเพศไม่ยอมหยุด"
    },
    {
      "id": "b58",
      "type": "narration",
      "text": "ฉันถูกกระตุ้นให้เขย่าอายะอีกครั้ง"
    },
    {
      "id": "b59",
      "type": "narration",
      "text": "ในตอนนั้น"
    },
    {
      "id": "b60",
      "type": "narration",
      "text": "ไฟถนนใกล้ๆ ก็กระพริบ"
    },
    {
      "id": "b61",
      "type": "narration",
      "text": "---หยุดเถอะ"
    },
    {
      "id": "b62",
      "type": "narration",
      "text": "สัญชาตญาณของพระเจ้าส่งสัญญาณเตือน"
    },
    {
      "id": "b63",
      "type": "narration",
      "text": "ฉันตกใจ"
    },
    {
      "id": "b64",
      "type": "narration",
      "text": "แล้วผละริมฝีปากออกจากอายะ"
    },
    {
      "id": "b65",
      "type": "narration",
      "text": "...อันตราย"
    },
    {
      "id": "b66",
      "type": "narration",
      "text": "ถ้าเป็นแบบนี้ต่อไป"
    },
    {
      "id": "b67",
      "type": "narration",
      "text": "เราคงจะทำกันจนถึงเช้า"
    },
    {
      "id": "b68",
      "type": "narration",
      "text": "ถึงเวลาต้องหยุดแล้ว"
    },
    {
      "id": "b69",
      "type": "narration",
      "text": "ถ้าฉันรั้งอายะไว้มากกว่านี้"
    },
    {
      "id": "b70",
      "type": "narration",
      "text": "ครอบครัวของเธอต้องเป็นห่วงแน่ๆ"
    },
    {
      "id": "b71",
      "type": "narration",
      "text": "และฉันแน่ใจว่า"
    },
    {
      "id": "b72",
      "type": "narration",
      "text": "อายะเองก็อยากจะคุยกับฉันแล้ว"
    },
    {
      "id": "b73",
      "type": "narration",
      "text": "ฉันสอดมือเข้าไปใต้ต้นขาของอายะ"
    },
    {
      "id": "b74",
      "type": "narration",
      "text": "ที่ยังคงล่องลอยอยู่"
    },
    {
      "id": "b75",
      "type": "narration",
      "text": "แล้วก็ยกเธอขึ้นอย่างช้าๆ"
    },
    {
      "id": "b76",
      "type": "narration",
      "text": "น้องชายของฉันค่อยๆ หลุดออกมา"
    },
    {
      "id": "b77",
      "type": "narration",
      "text": "จากช่องคลอดของเธอ"
    },
    {
      "id": "b78",
      "type": "narration",
      "text": "ด้วยเสียง "
    },
    {
      "id": "b79",
      "type": "narration",
      "text": "\"นุปปุ...\""
    },
    {
      "id": "b80",
      "type": "narration",
      "text": "แค่นั้นก็ทำให้ฉันรู้สึกดีอีกครั้ง"
    },
    {
      "id": "b81",
      "type": "narration",
      "text": "แต่ฉันต้องอดทน"
    },
    {
      "id": "b82",
      "type": "narration",
      "text": "เมื่อฉันใช้สติทั้งหมดเพื่อตัดขาด"
    },
    {
      "id": "b83",
      "type": "narration",
      "text": "ฉันก็ค่อยๆ หย่อนอายะลง"
    },
    {
      "id": "b84",
      "type": "narration",
      "text": "อายะลุกขึ้นจากม้านั่ง"
    },
    {
      "id": "b85",
      "type": "narration",
      "text": "แล้วก็จับไหล่ของฉัน"
    },
    {
      "id": "b86",
      "type": "narration",
      "text": "ในตอนนั้น"
    },
    {
      "id": "b87",
      "type": "narration",
      "text": "ของเหลวก็หยดลงมาที่ต้นขาของอายะ"
    },
    {
      "id": "b88",
      "type": "narration",
      "text": "ฉันหยิบผ้าเช็ดหน้าออกจากกระเป๋า"
    },
    {
      "id": "b89",
      "type": "narration",
      "text": "แต่อายะก็กระซิบด้วยเสียงสั่นๆ ว่า"
    },
    {
      "id": "b90",
      "type": "dialogue",
      "text": "\"ไม่... เป็นไร...",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b91",
      "type": "dialogue",
      "text": "มีทิชชู่อยู่\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b92",
      "type": "narration",
      "text": "อายะหยิบทิชชู่ออกจากกระโปรง"
    },
    {
      "id": "b93",
      "type": "dialogue",
      "text": "\"โบยัน... หันไป... ทางอื่นนะ\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b94",
      "type": "narration",
      "text": "ฉันหันหลังให้เธอตามที่เธอขอ"
    },
    {
      "id": "b95",
      "type": "narration",
      "text": "ฉันก็ใช้ทิชชู่อยู่เหมือนกัน"
    },
    {
      "id": "b96",
      "type": "narration",
      "text": "เพื่อเช็ดบริเวณนั้น"
    },
    {
      "id": "b97",
      "type": "narration",
      "text": "ในขณะที่ยังรู้สึกดี"
    },
    {
      "id": "b98",
      "type": "narration",
      "text": "ฉันพยายามอย่างหนัก"
    },
    {
      "id": "b99",
      "type": "narration",
      "text": "ที่จะใส่กางเกงในและกางเกงขายาว"
    },
    {
      "id": "b100",
      "type": "narration",
      "text": "แล้วก็รออย่างใจลอย"
    },
    {
      "id": "b101",
      "type": "narration",
      "text": "มองดูไฟถนนที่กระพริบอยู่สักพัก"
    },
    {
      "id": "b102",
      "type": "dialogue",
      "text": "\"เสร็จแล้ว\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b103",
      "type": "narration",
      "text": "เมื่อฉันหันไปหาเสียง"
    },
    {
      "id": "b104",
      "type": "narration",
      "text": "อายะยืนอยู่"
    },
    {
      "id": "b105",
      "type": "narration",
      "text": "เธอใส่เสื้อเชิ้ตแล้ว"
    },
    {
      "id": "b106",
      "type": "narration",
      "text": "แต่บางส่วนของเสื้อและกระโปรงก็ยับยู่ยี่"
    },
    {
      "id": "b107",
      "type": "narration",
      "text": "ทำให้บรรยากาศหลังการร่วมรักยังคงอยู่"
    },
    {
      "id": "b108",
      "type": "narration",
      "text": "ผมของเธอยุ่งเล็กน้อย"
    },
    {
      "id": "b109",
      "type": "narration",
      "text": "และเธอดู... เซ็กซี่มากๆ"
    },
    {
      "id": "b110",
      "type": "narration",
      "text": "ไม่ ไม่ ไม่"
    },
    {
      "id": "b111",
      "type": "narration",
      "text": "ฉันตบแก้มตัวเองในความคิด"
    },
    {
      "id": "b112",
      "type": "narration",
      "text": "แล้วก็นั่งลงข้างๆ อายะบนม้านั่ง"
    },
    {
      "id": "b113",
      "type": "narration",
      "text": "ลมกลางคืนรู้สึกสบาย"
    },
    {
      "id": "b114",
      "type": "narration",
      "text": "บนร่างกายที่ร้อนผ่าวของเรา"
    },
    {
      "id": "b115",
      "type": "narration",
      "text": "บางทีอาจเป็นเพราะเราเพิ่งใกล้ชิดกัน"
    },
    {
      "id": "b116",
      "type": "narration",
      "text": "เราจึงรู้สึกใกล้ชิดกันมากขึ้นกว่าเมื่อก่อน"
    },
    {
      "id": "b117",
      "type": "narration",
      "text": "เราต่างก็อยากจะรู้สึกถึงกัน"
    },
    {
      "id": "b118",
      "type": "narration",
      "text": "และสัมผัสกันให้ได้มากที่สุด"
    },
    {
      "id": "b119",
      "type": "narration",
      "text": "ฉันจับมือของอายะด้วยมือข้างเดียว"
    },
    {
      "id": "b120",
      "type": "narration",
      "text": "แล้วก็ยกอีกข้างขึ้น"
    },
    {
      "id": "b121",
      "type": "narration",
      "text": "เพื่อลูบหัวเธอ... แต่ก็หยุดไว้"
    },
    {
      "id": "b122",
      "type": "dialogue",
      "text": "\"ขอโทษนะ...",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b123",
      "type": "dialogue",
      "text": "ผมยุ่งไปหมดเลย\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b124",
      "type": "dialogue",
      "text": "\"ไม่เป็นไร...",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b125",
      "type": "dialogue",
      "text": "เดี๋ยวก็ไปอาบน้ำแล้ว\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b126",
      "type": "narration",
      "text": "อายะมองมือที่ลอยค้างของฉัน"
    },
    {
      "id": "b127",
      "type": "narration",
      "text": "แล้วก็หัวเราะออกมา"
    },
    {
      "id": "b128",
      "type": "dialogue",
      "text": "\"ไม่เป็นไร... จับเลย\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b129",
      "type": "narration",
      "text": "เมื่อได้รับอนุญาต"
    },
    {
      "id": "b130",
      "type": "narration",
      "text": "ฉันก็ลูบหัวของอายะอย่างเต็มที่"
    },
    {
      "id": "b131",
      "type": "narration",
      "text": "ขณะที่ฉันใช้ปลายนิ้วสางผมสีน้ำตาลที่นุ่มสลวยของเธอ"
    },
    {
      "id": "b132",
      "type": "narration",
      "text": "อายะก็เอียงหัวเข้ามาพิงไหล่ฉัน"
    },
    {
      "id": "b133",
      "type": "dialogue",
      "text": "\"ฉัน...",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b134",
      "type": "dialogue",
      "text": "จะไปเดทกับโทกิตะสุดสัปดาห์นี้\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b135",
      "type": "narration",
      "text": "อายะบอกฉันอย่างประหม่า"
    },
    {
      "id": "b136",
      "type": "dialogue",
      "text": "\"สุดสัปดาห์นี้?",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b137",
      "type": "dialogue",
      "text": "หลังงานโรงเรียนเหรอ?\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b138",
      "type": "narration",
      "text": "ฉันตอบกลับอย่างสบายๆ"
    },
    {
      "id": "b139",
      "type": "narration",
      "text": "เหมือนกับกำลังคุยเรื่องทั่วไป"
    },
    {
      "id": "b140",
      "type": "dialogue",
      "text": "\"อื้ม... วันอาทิตย์...",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b141",
      "type": "dialogue",
      "text": "วันถัดจากงานโรงเรียน\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b142",
      "type": "dialogue",
      "text": "\"เหรอ\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b143",
      "type": "dialogue",
      "text": "\"...ทำไมดูไม่สนใจเลย\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b144",
      "type": "narration",
      "text": "อายะเม้มปากเล็กน้อย"
    },
    {
      "id": "b145",
      "type": "narration",
      "text": "ความประหม่าของเธอลดลงไปเล็กน้อย"
    },
    {
      "id": "b146",
      "type": "dialogue",
      "text": "\"จะไปเดทที่ไหนเหรอ?\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b147",
      "type": "dialogue",
      "text": "\"ยัง... ไม่ได้ตัดสินใจ...",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b148",
      "type": "dialogue",
      "text": "ดูเหมือนนะ\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b149",
      "type": "dialogue",
      "text": "\"อ๋อ\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b150",
      "type": "dialogue",
      "text": "\"แล้วก็... นะ...\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b151",
      "type": "narration",
      "text": "เสียงของอายะเริ่มสั่น"
    },
    {
      "id": "b152",
      "type": "narration",
      "text": "มือที่จับกันอยู่ก็สั่นเช่นกัน"
    },
    {
      "id": "b153",
      "type": "narration",
      "text": "เธอดูเหมือนจะพูดคำต่อไปไม่ได้"
    },
    {
      "id": "b154",
      "type": "narration",
      "text": "ริมฝีปากของเธอก็เปิดและปิดเล็กน้อย"
    },
    {
      "id": "b155",
      "type": "narration",
      "text": "ความรู้สึกของอายะถูกส่งมาถึงฉัน"
    },
    {
      "id": "b156",
      "type": "narration",
      "text": "จากกำปั้นที่บีบแน่น"
    },
    {
      "id": "b157",
      "type": "narration",
      "text": "---กลัว"
    },
    {
      "id": "b158",
      "type": "narration",
      "text": "กลัวมาก"
    },
    {
      "id": "b159",
      "type": "narration",
      "text": "แต่"
    },
    {
      "id": "b160",
      "type": "narration",
      "text": "ฉัน"
    },
    {
      "id": "b161",
      "type": "narration",
      "text": "ไม่สามารถ"
    },
    {
      "id": "b162",
      "type": "narration",
      "text": "คบกับโทกิตะได้อีกแล้ว"
    },
    {
      "id": "b163",
      "type": "narration",
      "text": "เพราะฉันอยู่กับโบยันแบบนี้"
    },
    {
      "id": "b164",
      "type": "narration",
      "text": "แต่"
    },
    {
      "id": "b165",
      "type": "narration",
      "text": "ก็ยังกลัวอยู่ดี"
    },
    {
      "id": "b166",
      "type": "narration",
      "text": "ทำไม"
    },
    {
      "id": "b167",
      "type": "narration",
      "text": "ฉันถึงแย่แบบนี้นะ"
    },
    {
      "id": "b168",
      "type": "narration",
      "text": "ขณะที่ฉันรู้สึกถึงความรู้สึกที่สั่นคลอนของอายะ"
    },
    {
      "id": "b169",
      "type": "narration",
      "text": "ฉันก็นึกถึงคำพูดของพี่สาว"
    },
    {
      "id": "b170",
      "type": "narration",
      "text": "---เมื่อผู้หญิงตัดสินใจเลิก"
    },
    {
      "id": "b171",
      "type": "narration",
      "text": "ก็ต่อเมื่อผู้ชายทำผิดจนหมดความอดทนแล้ว"
    },
    {
      "id": "b172",
      "type": "narration",
      "text": "พี่สาวของฉันถึงกับพูดว่า"
    },
    {
      "id": "b173",
      "type": "narration",
      "text": "ถ้าเธอสนใจผู้ชายคนอื่น"
    },
    {
      "id": "b174",
      "type": "narration",
      "text": "แฟนคนปัจจุบันของเธอก็จะไม่สำคัญอีกต่อไป"
    },
    {
      "id": "b175",
      "type": "narration",
      "text": "แต่อายะดูจะแตกต่างออกไปมาก"
    },
    {
      "id": "b176",
      "type": "narration",
      "text": "ไม่สิ ไม่ใช่แบบนั้น"
    },
    {
      "id": "b177",
      "type": "narration",
      "text": "อายะเองก็ตัดขาดจากโทกิตะแล้ว"
    },
    {
      "id": "b178",
      "type": "narration",
      "text": "เธอเอาชนะบาดแผลในใจได้แล้ว"
    },
    {
      "id": "b179",
      "type": "narration",
      "text": "และเธอก็ตัดสินใจที่จะเลิก"
    },
    {
      "id": "b180",
      "type": "narration",
      "text": "แต่ลึกๆ ในใจ"
    },
    {
      "id": "b181",
      "type": "narration",
      "text": "ในที่สุด"
    },
    {
      "id": "b182",
      "type": "narration",
      "text": "เธอก็กลัว"
    },
    {
      "id": "b183",
      "type": "narration",
      "text": "เธอไม่สามารถควบคุมความกลัวนี้ได้"
    },
    {
      "id": "b184",
      "type": "narration",
      "text": "อายะ... เธอไม่ผิดเลย..."
    },
    {
      "id": "b185",
      "type": "narration",
      "text": "---อย่าพูดนะ"
    },
    {
      "id": "b186",
      "type": "narration",
      "text": "ฉันเกือบจะพูดออกไปแล้ว"
    },
    {
      "id": "b187",
      "type": "narration",
      "text": "แต่สัญชาตญาณก็ห้ามไว้"
    },
    {
      "id": "b188",
      "type": "narration",
      "text": "ฉันเลยได้แต่กอดอายะไว้"
    },
    {
      "id": "b189",
      "type": "narration",
      "text": "ลมหายใจของอายะไม่สม่ำเสมอ"
    },
    {
      "id": "b190",
      "type": "narration",
      "text": "ฉันรู้สึกได้ว่าหัวใจของเธอเต้นแรง"
    },
    {
      "id": "b191",
      "type": "narration",
      "text": "อายะ... ทุกอย่างเป็นความผิดของฉัน..."
    },
    {
      "id": "b192",
      "type": "narration",
      "text": "---อย่าพูดอะไรเลย"
    },
    {
      "id": "b193",
      "type": "narration",
      "text": "ฉันเกือบจะพูดออกไปอีกครั้ง"
    },
    {
      "id": "b194",
      "type": "narration",
      "text": "แต่สัญชาตญาณก็ห้ามไว้"
    },
    {
      "id": "b195",
      "type": "narration",
      "text": "...ฉันเข้าใจแล้ว"
    },
    {
      "id": "b196",
      "type": "narration",
      "text": "ฉันต้องไม่ให้อายะมีข้ออ้างในการเลิกกับโทกิตะ"
    },
    {
      "id": "b197",
      "type": "narration",
      "text": "ฉันต้องไม่ให้อายะเลิกกับเขา"
    },
    {
      "id": "b198",
      "type": "narration",
      "text": "เพราะโดนฉันชักนำ"
    },
    {
      "id": "b199",
      "type": "narration",
      "text": "ฉันต้องไม่ให้อายะพึ่งพาฉัน"
    },
    {
      "id": "b200",
      "type": "narration",
      "text": "อายะเองก็เข้าใจเรื่องนี้ดีอยู่แล้ว"
    },
    {
      "id": "b201",
      "type": "narration",
      "text": "ดังนั้น"
    },
    {
      "id": "b202",
      "type": "narration",
      "text": "ฉันจะไม่พูดอะไรเลย"
    },
    {
      "id": "b203",
      "type": "narration",
      "text": "ฉันแค่กอดอายะไว้เงียบๆ"
    },
    {
      "id": "b204",
      "type": "narration",
      "text": "อายะก็กอดแขนของฉันไว้แน่น"
    },
    {
      "id": "b205",
      "type": "narration",
      "text": "ความรู้สึกที่ร้อนรนของอายะ"
    },
    {
      "id": "b206",
      "type": "narration",
      "text": "ถูกส่งมาถึงฉัน"
    },
    {
      "id": "b207",
      "type": "narration",
      "text": "---ทำไงดี"
    },
    {
      "id": "b208",
      "type": "narration",
      "text": "ทำไงดี"
    },
    {
      "id": "b209",
      "type": "narration",
      "text": "ฉัน"
    },
    {
      "id": "b210",
      "type": "narration",
      "text": "ชอบ"
    },
    {
      "id": "b211",
      "type": "narration",
      "text": "โบยัน"
    },
    {
      "id": "b212",
      "type": "narration",
      "text": "มากขนาดนี้"
    },
    {
      "id": "b213",
      "type": "narration",
      "text": "ชอบ"
    },
    {
      "id": "b214",
      "type": "narration",
      "text": "ฉัน"
    },
    {
      "id": "b215",
      "type": "narration",
      "text": "ชอบ"
    },
    {
      "id": "b216",
      "type": "narration",
      "text": "โบยัน"
    },
    {
      "id": "b217",
      "type": "narration",
      "text": "ฉันจะทำยังไงดีนะ"
    },
    {
      "id": "b218",
      "type": "narration",
      "text": "อายะสารภาพรักกับฉัน"
    },
    {
      "id": "b219",
      "type": "narration",
      "text": "ในใจของเธอ"
    },
    {
      "id": "b220",
      "type": "narration",
      "text": "บอกตามตรง"
    },
    {
      "id": "b221",
      "type": "narration",
      "text": "หัวใจของฉันแทบจะหยุดเต้น"
    },
    {
      "id": "b222",
      "type": "narration",
      "text": "ฉันแข็งทื่อไปหมด"
    },
    {
      "id": "b223",
      "type": "narration",
      "text": "ไม่พูดอะไรเลย"
    },
    {
      "id": "b224",
      "type": "dialogue",
      "text": "\"...\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b225",
      "type": "dialogue",
      "text": "\"...\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b226",
      "type": "narration",
      "text": "หลังจากนั้นไม่นาน"
    },
    {
      "id": "b227",
      "type": "narration",
      "text": "อายะก็เริ่มเช็ดน้ำตาด้วยเสื้อของฉัน"
    },
    {
      "id": "b228",
      "type": "narration",
      "text": "ฉันลูบหัวของอายะ"
    },
    {
      "id": "b229",
      "type": "narration",
      "text": "เพื่อบอกว่า "
    },
    {
      "id": "b230",
      "type": "narration",
      "text": "\"ไม่เป็นไร\""
    },
    {
      "id": "b231",
      "type": "narration",
      "text": "อายะหายใจเข้าลึกๆ ว่า "
    },
    {
      "id": "b232",
      "type": "narration",
      "text": "\"ฮู้\""
    },
    {
      "id": "b233",
      "type": "narration",
      "text": "แล้วก็พูดต่อ"
    },
    {
      "id": "b234",
      "type": "narration",
      "text": "เธอมองมาที่หน้าอกของฉัน"
    },
    {
      "id": "b235",
      "type": "narration",
      "text": "แล้วก็เริ่มพูด"
    },
    {
      "id": "b236",
      "type": "dialogue",
      "text": "\"แล้ว... ตอนไปเดท...",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b237",
      "type": "dialogue",
      "text": "ฉันตั้งใจจะบอกเขา\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b238",
      "type": "dialogue",
      "text": "\"บอกว่าอะไร?\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b239",
      "type": "dialogue",
      "text": "\"...เลิกกันเถอะ\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b240",
      "type": "narration",
      "text": "ในที่สุดอายะก็พูดมันออกมา"
    },
    {
      "id": "b241",
      "type": "dialogue",
      "text": "\"อืม\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b242",
      "type": "narration",
      "text": "ฉันจูบหน้าผากของอายะ"
    },
    {
      "id": "b243",
      "type": "narration",
      "text": "อายะตอบกลับว่า "
    },
    {
      "id": "b244",
      "type": "narration",
      "text": "\"อื้ม...\""
    },
    {
      "id": "b245",
      "type": "narration",
      "text": "เบาๆ"
    },
    {
      "id": "b246",
      "type": "narration",
      "text": "แล้วก็หลับตาลง"
    },
    {
      "id": "b247",
      "type": "dialogue",
      "text": "\"ขอให้สนุกกับการเดทนะ\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b248",
      "type": "dialogue",
      "text": "\"ไม่นะ... ฉันจะไปบอกเลิก\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b249",
      "type": "narration",
      "text": "โอ้..."
    },
    {
      "id": "b250",
      "type": "narration",
      "text": "ฉันเผลอพูดไปตามความเคยชิน"
    },
    {
      "id": "b251",
      "type": "narration",
      "text": "เพราะทุกครั้งที่ฉันได้ยินว่าเธอจะไปเดทกับโทกิตะ"
    },
    {
      "id": "b252",
      "type": "narration",
      "text": "ฉันก็จะพูดแบบนี้เสมอ"
    },
    {
      "id": "b253",
      "type": "narration",
      "text": "อายะขมวดคิ้ว"
    },
    {
      "id": "b254",
      "type": "narration",
      "text": "แล้วก็ทำหน้าตาเหมือนกำลังลำบากใจ"
    },
    {
      "id": "b255",
      "type": "narration",
      "text": "แล้วเธอก็หัวเราะเบาๆ"
    },
    {
      "id": "b256",
      "type": "narration",
      "text": "ราวกับจะหยอกล้อฉัน"
    },
    {
      "id": "b257",
      "type": "narration",
      "text": "อายะยังคงกลัวอยู่"
    },
    {
      "id": "b258",
      "type": "narration",
      "text": "ถ้าเธอเริ่มพูดเรื่องเลิก"
    },
    {
      "id": "b259",
      "type": "narration",
      "text": "แล้วโทกิตะขอร้องว่า "
    },
    {
      "id": "b260",
      "type": "narration",
      "text": "\"ไม่อยากเลิก\""
    },
    {
      "id": "b261",
      "type": "narration",
      "text": "เธอจะพูดอย่างชัดเจนได้ไหม"
    },
    {
      "id": "b262",
      "type": "narration",
      "text": "ถ้าเธอนึกถึงเพื่อนผู้หญิงของเธอ"
    },
    {
      "id": "b263",
      "type": "narration",
      "text": "แล้วบาดแผลในใจของเธอก็ระเบิดขึ้น"
    },
    {
      "id": "b264",
      "type": "narration",
      "text": "แล้วในงานโรงเรียน"
    },
    {
      "id": "b265",
      "type": "narration",
      "text": "ก็มีการประกาศรางวัลคู่รักยอดเยี่ยม"
    },
    {
      "id": "b266",
      "type": "narration",
      "text": "มันคงจะโหดร้ายเกินไป"
    },
    {
      "id": "b267",
      "type": "narration",
      "text": "ที่จะทำแบบนี้ก่อนวันงาน"
    },
    {
      "id": "b268",
      "type": "narration",
      "text": "แต่แน่นอน"
    },
    {
      "id": "b269",
      "type": "narration",
      "text": "ฉันจะไม่ปล่อยให้อายะต้องไปยืนบนเวทีนั้น"
    },
    {
      "id": "b270",
      "type": "narration",
      "text": "อายะพูดคำว่า "
    },
    {
      "id": "b271",
      "type": "narration",
      "text": "\"เลิก\""
    },
    {
      "id": "b272",
      "type": "narration",
      "text": " ออกมาแล้ว"
    },
    {
      "id": "b273",
      "type": "narration",
      "text": "เธอตัดสินใจที่จะทำมันแล้ว"
    },
    {
      "id": "b274",
      "type": "narration",
      "text": "ถ้าอย่างนั้น"
    },
    {
      "id": "b275",
      "type": "narration",
      "text": "ฉันก็จะทำสิ่งที่ฉันทำได้"
    },
    {
      "id": "b276",
      "type": "narration",
      "text": "ในขณะที่ฉันกำลังตัดสินใจอย่างเงียบๆ"
    },
    {
      "id": "b277",
      "type": "narration",
      "text": "อายะก็เริ่มพูดกับฉัน"
    },
    {
      "id": "b278",
      "type": "dialogue",
      "text": "\"นี่ โบยัน\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b279",
      "type": "dialogue",
      "text": "\"หือ?\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b280",
      "type": "dialogue",
      "text": "\"ขออยู่แบบนี้...",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b281",
      "type": "dialogue",
      "text": "อีกหน่อย... ได้ไหม?\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b282",
      "type": "narration",
      "text": "ดูเหมือนว่าอายะจะตัดสินใจที่จะอ้อนฉันอย่างเปิดเผยแล้ว"
    },
    {
      "id": "b283",
      "type": "narration",
      "text": "ท้ายทอยของอายะพิงอยู่บนหน้าอกของฉัน"
    },
    {
      "id": "b284",
      "type": "narration",
      "text": "เธอกำลังทิ้งน้ำหนักลงมาอย่างไม่ป้องกันตัว"
    },
    {
      "id": "b285",
      "type": "narration",
      "text": "เหมือนกับกำลังนั่งอย่างสบายๆ บนเก้าอี้"
    },
    {
      "id": "b286",
      "type": "narration",
      "text": "ทั้งที่ยังไม่ได้บอกเลิกกับแฟนเลย"
    },
    {
      "id": "b287",
      "type": "narration",
      "text": "แต่อายะก็ผ่อนคลาย"
    },
    {
      "id": "b288",
      "type": "narration",
      "text": "เหมือนกับยกภูเขาออกจากอก"
    },
    {
      "id": "b289",
      "type": "narration",
      "text": "ถ้าเป็นแบบนี้ต่อไป"
    },
    {
      "id": "b290",
      "type": "narration",
      "text": "เธอคงจะหลับไป"
    },
    {
      "id": "b291",
      "type": "dialogue",
      "text": "\"อายะ... อย่าเพิ่งนอนนะ\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b292",
      "type": "dialogue",
      "text": "\"ก็โบยัน...",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b293",
      "type": "dialogue",
      "text": "เป็นหมอนที่นุ่มสบาย\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b294",
      "type": "dialogue",
      "text": "\"ฉันไม่ใช่หมอนนะ\"",
      "speakerId": "protagonist",
      "speakerName": "โบยัน (ตัวเอก)"
    },
    {
      "id": "b295",
      "type": "narration",
      "text": "ไม่สิ"
    },
    {
      "id": "b296",
      "type": "narration",
      "text": "ฉันตั้งใจจะเป็นหมอนของอายะไปตลอดชีวิตอยู่แล้ว"
    },
    {
      "id": "b297",
      "type": "dialogue",
      "text": "\"ฮึๆ\"",
      "speakerId": "aya",
      "speakerName": "มินะโทริ อายะ"
    },
    {
      "id": "b298",
      "type": "narration",
      "text": "อายะเอาท้ายทอยถูไถกับหน้าอกของฉันอย่างสนุกสนาน"
    },
    {
      "id": "b299",
      "type": "narration",
      "text": "ท่าทางของเธอเหมือนแมว"
    },
    {
      "id": "b300",
      "type": "narration",
      "text": "บอกได้คำเดียวว่า"
    },
    {
      "id": "b301",
      "type": "narration",
      "text": "น่ารักเกินไป"
    },
    {
      "id": "b302",
      "type": "narration",
      "text": "บอกตามตรง"
    },
    {
      "id": "b303",
      "type": "narration",
      "text": "ฉันอยากจะตะโกนว่า "
    },
    {
      "id": "b304",
      "type": "narration",
      "text": "\"ฉันอิ่มแล้ว!\""
    },
    {
      "id": "b305",
      "type": "narration",
      "text": "เมื่อก่อน"
    },
    {
      "id": "b306",
      "type": "narration",
      "text": "ฉันคงได้แต่นั่งฝันแบบนี้"
    },
    {
      "id": "b307",
      "type": "narration",
      "text": "จะมีอะไรอีกไหม"
    },
    {
      "id": "b308",
      "type": "narration",
      "text": "ที่จะทำให้อายะเป็นของฉันได้มากกว่านี้?"
    },
    {
      "id": "b309",
      "type": "narration",
      "text": "---มีสิ"
    },
    {
      "id": "b310",
      "type": "narration",
      "text": "สัญชาตญาณบอกแบบนั้น"
    },
    {
      "id": "b311",
      "type": "narration",
      "text": "ฉันจะทำให้อายะเป็นของฉันอย่างสมบูรณ์"
    },
    {
      "id": "b312",
      "type": "narration",
      "text": "ในงานโรงเรียน"
    },
    {
      "id": "b313",
      "type": "narration",
      "text": "ด้วยวิธีที่ชัดเจนที่สุด"
    },
    {
      "id": "b314",
      "type": "narration",
      "text": "บางสิ่งบางอย่างที่เด็ดขาด"
    },
    {
      "id": "b315",
      "type": "narration",
      "text": "ที่จะทำให้อายะถูกช่วงชิงจากโทกิตะ"
    },
    {
      "id": "b316",
      "type": "narration",
      "text": "ฉันมีความเชื่อมั่นที่หนักแน่นเช่นนั้น"
    },
    {
      "id": "b317",
      "type": "narration",
      "text": "ในที่สุด"
    },
    {
      "id": "b318",
      "type": "narration",
      "text": "พรุ่งนี้ก็เป็นวันแรกของงานโรงเรียนแล้ว"
    },
    {
      "id": "b319",
      "type": "narration",
      "text": "...ไม่สิ"
    },
    {
      "id": "b320",
      "type": "narration",
      "text": "วันนี้แล้วต่างหาก"
    },
    {
      "id": "b321",
      "type": "narration",
      "text": "เข็มนาฬิกาของสวนสาธารณะ"
    },
    {
      "id": "b322",
      "type": "narration",
      "text": "ชี้ไปที่ตีหนึ่งแล้ว"
    },
    {
      "id": "b323",
      "type": "narration",
      "text": "ท่านใดสนใจสามารถกด Follow Page ผมไว้ได้นะครับ"
    },
    {
      "id": "b324",
      "type": "narration",
      "text": "บางเรื่องจะลงในเพจก่อนลงใน Neko นะครับ"
    },
    {
      "id": "b325",
      "type": "narration",
      "text": "ขอบคุณคับ"
    }
  ]
}

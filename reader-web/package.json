{
  "name": "yomiori-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run conversion:check",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "conversion": "node scripts/conversion-pipeline.mjs",
    "conversion:check": "node scripts/conversion-pipeline.mjs audit",
    "verify:release": "node scripts/verify-release.mjs",
    "verify": "node scripts/verify-conversion.mjs",
    "chapters:status": "node scripts/import-chapters.mjs --status",
    "chapters:audit": "node scripts/import-chapters.mjs --audit",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs scripts/blackcat-conversion.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
